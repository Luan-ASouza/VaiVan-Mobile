rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // FUNÇÕES AUXILIARES
    // ===================================================================

    function logado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return logado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Assinatura em dia: ATIVA, dentro do ciclo ou dos 3 dias de carência
    // (259200000 ms), e sem cancelamento já vencido.
    function assinaturaOperacional(motoristaId) {
      let ref = /databases/$(database)/documents/assinaturas/$(motoristaId);
      return exists(ref) &&
        get(ref).data.status == 'ATIVA' &&
        request.time.toMillis() <= get(ref).data.proximaCobranca + 259200000 &&
        (get(ref).data.cancelamentoAgendado == false ||
         request.time.toMillis() <= get(ref).data.proximaCobranca);
    }

    // O motorista NUNCA se aprova sozinho: só pode ir para PENDENTE ou
    // EM_ANALISE. "ATIVO" e "SUSPENSO" só o administrador grava.
    function statusMotoristaPermitido() {
      let antes = resource.data.get('statusMotorista', null);
      let depois = request.resource.data.get('statusMotorista', null);
      return antes == depois ||
        (depois == 'PENDENTE' && (antes == null || antes == 'PENDENTE')) ||
        (depois == 'EM_ANALISE' &&
          (antes == null || antes == 'PENDENTE' || antes == 'EM_ANALISE'));
    }


    // ===================================================================
    // USUÁRIOS (perfil de responsável ou motorista, doc id = uid)
    // ===================================================================
    match /usuarios/{uid} {
      allow read: if logado();

      allow create: if logado() && request.auth.uid == uid &&
        !('statusMotorista' in request.resource.data);

      allow update: if (logado() && request.auth.uid == uid &&
                        statusMotoristaPermitido()) || ehAdmin();

      allow delete: if logado() && request.auth.uid == uid;

      // Cópia antiga dos documentos (o app não usa mais): só leitura.
      match /documentos/{documentoId} {
        allow read: if logado() && request.auth.uid == uid;
      }
    }

    // ESCOLAS
    match /escolas/{escolaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ===================================================================
    // DOCUMENTOS (motorista e veículo)
    // ===================================================================
    match /documentos/{documentoId} {
      allow read: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());

      // O motorista só envia documentos dele e sempre "em análise".
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        request.resource.data.statusValidacao == 'EM_ANALISE';

      // Aprovar/rejeitar: só admin. O motorista pode apenas REENVIAR o
      // documento (inclusive trocar um já aprovado): ele volta para
      // análise, e o motorista nunca se aprova sozinho.
      allow update: if ehAdmin() ||
        (logado() &&
         resource.data.motoristaId == request.auth.uid &&
         request.resource.data.motoristaId == request.auth.uid &&
         request.resource.data.statusValidacao == 'EM_ANALISE');

      allow delete: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
    }

    // VEÍCULOS
    match /veiculos/{veiculoId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.motoristaId;
    }

    // PASSAGEIROS
    match /passageiros/{passageiroId} {
      allow create: if request.auth != null
                        && request.resource.data.responsavelId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                        && resource.data.responsavelId == request.auth.uid;
    }

    // LOCAIS (pontos de embarque)
    match /locais/{localId} {
      allow create: if request.auth != null
                        && request.resource.data.responsavelId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                        && resource.data.responsavelId == request.auth.uid;
    }

    // LOCALIZAÇÕES (rastreamento em tempo real) — um documento por viagem
    // (localizacoes/{viagemId}, sempre sobrescrito), com motoristaId e
    // responsaveisAutorizados denormalizados nele mesmo, no mesmo espírito
    // de "viagens", pra não depender de getAfter() numa escrita de alta
    // frequência.
    match /localizacoes/{viagemId} {
      // "resource == null": o responsável abre o acompanhamento antes de o
      // motorista mandar a primeira posição — sem isso a leitura de um
      // documento que ainda não existe é recusada e o mapa fica vazio.
      allow read: if logado() && (
        resource == null ||
        request.auth.uid == resource.data.motoristaId ||
        request.auth.uid in resource.data.responsaveisAutorizados ||
        ehAdmin()
      );

      allow write: if logado() && request.auth.uid == request.resource.data.motoristaId;
    }

    // CHAT
    // Cada conversa nasce de uma solicitação APROVADA e tem exatamente dois
    // participantes: o responsável e o motorista daquela solicitação.
    match /chats/{chatId} {

      function solicitacaoAprovadaEntre(solicitacaoId, participantes) {
        let ref = /databases/$(database)/documents/solicitacoes_inclusao/$(solicitacaoId);
        return exists(ref) &&
          get(ref).data.status == 'ACEITA' &&
          [get(ref).data.responsavelId, get(ref).data.motoristaId].hasAll(participantes);
      }

      // "get" também precisa funcionar quando a conversa ainda não existe
      allow get: if logado() &&
        (resource == null || request.auth.uid in resource.data.participantes);

      // lista só as conversas em que o usuário é participante
      allow list: if logado() &&
        request.auth.uid in resource.data.participantes;

      allow create: if logado() &&
        request.resource.data.participantes is list &&
        request.resource.data.participantes.size() == 2 &&
        request.resource.data.participantes[0] != request.resource.data.participantes[1] &&
        request.auth.uid in request.resource.data.participantes &&
        'solicitacaoId' in request.resource.data &&
        solicitacaoAprovadaEntre(
          request.resource.data.solicitacaoId,
          request.resource.data.participantes
        );

      // atualiza a "última mensagem", mas sem trocar os participantes
      allow update: if logado() &&
        request.auth.uid in resource.data.participantes &&
        request.resource.data.participantes == resource.data.participantes;

      match /mensagens/{mensagemId} {
        allow read: if logado() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;

        allow create: if logado() &&
          request.resource.data.remetenteId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
    }

    // ===================================================================
    // ROTAS (criar exige assinatura em dia)
    // ===================================================================
    match /rotas/{rotaId} {
      allow read: if request.auth != null;
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        assinaturaOperacional(request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.motoristaId == request.auth.uid;
    }

    match /paradas_rota/{paradaId} {
      allow read, write: if request.auth != null;
    }

    // ===================================================================
    // SOLICITAÇÕES DE INCLUSÃO (aceitar exige assinatura em dia)
    // ===================================================================
    match /solicitacoes_inclusao/{solicitacaoId} {
      // Quem pede (responsável) e quem recebe (motorista).
      allow read: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid);

      // Só é possível pedir vaga a um motorista com assinatura em dia.
      allow create: if logado() &&
        request.resource.data.responsavelId == request.auth.uid &&
        request.resource.data.status == 'PENDENTE' &&
        assinaturaOperacional(request.resource.data.motoristaId);

      // As duas partes podem atualizar (como antes), mas aceitar só é
      // possível se o motorista estiver com a assinatura em dia.
      allow update: if logado() &&
        (resource.data.motoristaId == request.auth.uid ||
         resource.data.responsavelId == request.auth.uid) &&
        (request.resource.data.status != 'ACEITA' ||
         assinaturaOperacional(resource.data.motoristaId));

      // PassageiroRepository.excluirPassageiro apaga, no mesmo batch do
      // passageiro, qualquer solicitação PENDENTE dele — sem essa regra o
      // batch inteiro falhava (inclusive a exclusão do próprio passageiro).
      allow delete: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid);
    }

    // ===================================================================
    // PLANOS E ASSINATURAS
    // ===================================================================

    // Assinatura do motorista (id do documento = uid do motorista)
    match /assinaturas/{motoristaId} {
      // Leitura individual liberada: o app do responsável precisa saber se o
      // motorista está em dia para mostrar a rota na busca.
      allow get: if logado();
      allow list: if ehAdmin();

      allow create, update: if logado() &&
        ((request.auth.uid == motoristaId &&
          request.resource.data.motoristaId == motoristaId) || ehAdmin());

      allow delete: if false;

      match /historico/{eventoId} {
        allow read: if logado() && (request.auth.uid == motoristaId || ehAdmin());
        allow create: if logado() && request.auth.uid == motoristaId;
        allow update, delete: if false;
      }
    }

    // Cobranças (mensalidades e upgrades)
    match /pagamentos/{pagamentoId} {
      allow read: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid;
      allow update: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
      allow delete: if false;
    }

    // ===================================================================
    // CONTRATOS E MENSALIDADES (responsável → motorista)
    // ===================================================================

    // Contrato: id = id da solicitação aceita. Só o motorista cria e altera;
    // as partes (motorista, responsável, passageiro) nunca mudam.
    match /contratos/{contratoId} {
      function ehParteDoContrato(d) {
        return request.auth.uid == d.motoristaId || request.auth.uid == d.responsavelId;
      }

      // "get" também precisa funcionar quando o contrato ainda não existe
      allow get: if logado() &&
        (resource == null || ehParteDoContrato(resource.data) || ehAdmin());
      allow list: if logado() && (ehParteDoContrato(resource.data) || ehAdmin());

      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        request.resource.data.status == 'ATIVO' &&
        exists(/databases/$(database)/documents/solicitacoes_inclusao/$(contratoId)) &&
        get(/databases/$(database)/documents/solicitacoes_inclusao/$(contratoId)).data.status == 'ACEITA' &&
        get(/databases/$(database)/documents/solicitacoes_inclusao/$(contratoId)).data.motoristaId == request.auth.uid &&
        get(/databases/$(database)/documents/solicitacoes_inclusao/$(contratoId)).data.responsavelId == request.resource.data.responsavelId &&
        get(/databases/$(database)/documents/solicitacoes_inclusao/$(contratoId)).data.passageiroId == request.resource.data.passageiroId;

      allow update: if logado() &&
        resource.data.motoristaId == request.auth.uid &&
        request.resource.data.diff(resource.data).unchangedKeys()
          .hasAll(['motoristaId', 'responsavelId', 'passageiroId', 'rotaId', 'inicioEm']);

      allow delete: if false;
    }

    // Mensalidade: id = "<contratoId>_<AAAA-MM>". Qualquer uma das partes pode
    // criar (quem abrir o app primeiro), mas sempre PENDENTE e com o valor do
    // contrato. Valor, vencimento e partes nunca mudam depois.
    match /mensalidades/{mensalidadeId} {
      function contrato(id) {
        return get(/databases/$(database)/documents/contratos/$(id)).data;
      }
      function ehParteDaMensalidade(d) {
        return request.auth.uid == d.motoristaId || request.auth.uid == d.responsavelId;
      }
      function confereComContrato(d) {
        return exists(/databases/$(database)/documents/contratos/$(d.contratoId)) &&
          d.motoristaId == contrato(d.contratoId).motoristaId &&
          d.responsavelId == contrato(d.contratoId).responsavelId &&
          d.valorCentavos == contrato(d.contratoId).valorMensalCentavos;
      }
      function camposFixosMantidos() {
        return request.resource.data.diff(resource.data).unchangedKeys()
          .hasAll(['contratoId', 'motoristaId', 'responsavelId', 'competencia', 'valorCentavos', 'vencimento']);
      }

      allow get: if logado() &&
        (resource == null || ehParteDaMensalidade(resource.data) || ehAdmin());
      allow list: if logado() && (ehParteDaMensalidade(resource.data) || ehAdmin());

      allow create: if logado() &&
        ehParteDaMensalidade(request.resource.data) &&
        mensalidadeId == request.resource.data.contratoId + '_' + request.resource.data.competencia &&
        request.resource.data.status == 'PENDENTE' &&
        confereComContrato(request.resource.data);

      allow update: if logado() && camposFixosMantidos() && (
        // Motorista: registra/desfaz recebimento e cancela (ao encerrar contrato).
        request.auth.uid == resource.data.motoristaId ||
        // Responsável: só paga pelo app (SIMULADO), de PENDENTE para PAGA.
        (request.auth.uid == resource.data.responsavelId &&
         resource.data.status == 'PENDENTE' &&
         request.resource.data.status == 'PAGA' &&
         request.resource.data.forma == 'PIX_APP' &&
         request.resource.data.registradoPor == 'RESPONSAVEL')
      );

      allow delete: if false; // histórico financeiro não se apaga
    }

    // Catálogo de planos: todos leem, só o admin altera.
    match /planos/{planoId} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    // ===== PAINEL ADMIN =====
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // ===================================================================
    // VIAGENS (execução de uma rota) e PARADAS/EVENTOS dessa viagem
    // ===================================================================

    // Iniciar viagem também exige assinatura em dia, pelo mesmo motivo de
    // "rotas": sem isso, um motorista inadimplente continuaria rodando.
    match /viagens/{viagemId} {
      allow read: if logado() && (
        request.auth.uid == resource.data.motoristaId ||
        request.auth.uid in resource.data.responsaveisAutorizados ||
        ehAdmin()
      );

      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        assinaturaOperacional(request.auth.uid);

      // Atualizações do dia a dia (pausar/retomar/avançar parada/finalizar)
      // não exigem assinatura em dia: não dá para abandonar crianças no meio
      // da rota por causa de uma cobrança atrasada no meio da viagem.
      allow update: if logado() && request.auth.uid == resource.data.motoristaId;

      allow delete: if false; // histórico, não se apaga pelo app
    }

    match /paradas_viagem/{paradaId} {
      // Responsável só lê a(s) parada(s) do(s) próprio(s) filho(s); o
      // motorista da viagem lê todas. getAfter() porque a viagem é criada
      // no mesmo batch que as paradas.
      allow read: if logado() && (
        request.auth.uid == resource.data.responsavelId ||
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(resource.data.viagemId)).data.motoristaId ||
        ehAdmin()
      );

      allow create, update: if logado() &&
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(request.resource.data.viagemId)).data.motoristaId;

      // Responsável marca falta com a viagem já em andamento
      // (ViagemRepository.aplicarAusenciaNaParadaAtiva): só na parada do
      // próprio filho, só a partir de um status pendente, e só pra
      // NAO_EMBARCOU (embarque) / DESEMBARCADO (desembarque). Nada além de
      // status, motivo e lastUpdated pode mudar.
      allow update: if logado() &&
        resource.data.responsavelId == request.auth.uid &&
        resource.data.status in ['AGUARDANDO', 'AGUARDANDO_DESEMBARQUE'] &&
        ((resource.data.tipo == 'EMBARQUE' && request.resource.data.status == 'NAO_EMBARCOU') ||
         (resource.data.tipo == 'DESEMBARQUE' && request.resource.data.status == 'DESEMBARCADO')) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'motivoAusencia', 'lastUpdated']);

      allow delete: if false;
    }

    match /eventos_viagem/{eventoId} {
      // Motorista sempre lê/cria os eventos da própria viagem. Responsável
      // autorizado da viagem também lê (gancho da notificação em app) e cria
      // só o evento de CHEGADA — detectado no próprio celular dele, por
      // proximidade do GPS, sem depender do motorista pra isso.
      allow read: if logado() && (
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(resource.data.viagemId)).data.motoristaId ||
        request.auth.uid in getAfter(/databases/$(database)/documents/viagens/$(resource.data.viagemId)).data.responsaveisAutorizados ||
        ehAdmin()
      );

      allow create: if logado() && (
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(request.resource.data.viagemId)).data.motoristaId ||
        (request.resource.data.tipo == 'CHEGADA' &&
         request.auth.uid in getAfter(/databases/$(database)/documents/viagens/$(request.resource.data.viagemId)).data.responsaveisAutorizados)
      );

      allow update, delete: if false;
    }

    // ===================================================================
    // AVISOS DE AUSÊNCIA (responsável avisa com antecedência que o filho não
    // vai usar o transporte — ver AvisoAusenciaRepository/IniciarViagemUseCase)
    // ===================================================================
    match /avisos_ausencia/{avisoId} {
      allow read: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid ||
         ehAdmin());

      allow create: if logado() &&
        request.resource.data.responsavelId == request.auth.uid;

      // Responsável cancela; motorista consome (zera pendenteIda/pendenteVolta
      // ao iniciar a viagem daquela direção) — ver marcarConsumido.
      allow update: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid);

      // Cancelamento (responsável) ou consumo final quando as duas direções
      // já foram atendidas (motorista).
      allow delete: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid);
    }
  }
}
