rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // FUNÇÕES AUXILIARES
    // ===================================================================

    function logado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return logado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Assinatura em dia: ATIVA, dentro do ciclo ou dos 3 dias de carência
    // (259200000 ms), e sem cancelamento já vencido.
    function assinaturaOperacional(motoristaId) {
      let ref = /databases/$(database)/documents/assinaturas/$(motoristaId);
      return exists(ref) &&
        get(ref).data.status == 'ATIVA' &&
        request.time.toMillis() <= get(ref).data.proximaCobranca + 259200000 &&
        (get(ref).data.cancelamentoAgendado == false ||
         request.time.toMillis() <= get(ref).data.proximaCobranca);
    }

    // O motorista NUNCA se aprova sozinho: só pode ir para PENDENTE ou
    // EM_ANALISE. "ATIVO" e "SUSPENSO" só o administrador grava.
    function statusMotoristaPermitido() {
      let antes = resource.data.get('statusMotorista', null);
      let depois = request.resource.data.get('statusMotorista', null);
      return antes == depois ||
        (depois == 'PENDENTE' && (antes == null || antes == 'PENDENTE')) ||
        (depois == 'EM_ANALISE' &&
          (antes == null || antes == 'PENDENTE' || antes == 'EM_ANALISE'));
    }


    // ===================================================================
    // USUÁRIOS (perfil de responsável ou motorista, doc id = uid)
    // ===================================================================
    match /usuarios/{uid} {
      allow read: if logado();

      allow create: if logado() && request.auth.uid == uid &&
        !('statusMotorista' in request.resource.data);

      allow update: if (logado() && request.auth.uid == uid &&
                        statusMotoristaPermitido()) || ehAdmin();

      allow delete: if logado() && request.auth.uid == uid;

      // Cópia antiga dos documentos (o app não usa mais): só leitura.
      match /documentos/{documentoId} {
        allow read: if logado() && request.auth.uid == uid;
      }
    }

    // ESCOLAS
    match /escolas/{escolaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ===================================================================
    // DOCUMENTOS (motorista e veículo)
    // ===================================================================
    match /documentos/{documentoId} {
      allow read: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());

      // O motorista só envia documentos dele e sempre "em análise".
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        request.resource.data.statusValidacao == 'EM_ANALISE';

      // Aprovar/rejeitar: só admin. O motorista pode apenas REENVIAR
      // (de REJEITADO/EM_ANALISE para EM_ANALISE), nunca se aprovar.
      allow update: if ehAdmin() ||
        (logado() &&
         resource.data.motoristaId == request.auth.uid &&
         request.resource.data.motoristaId == request.auth.uid &&
         resource.data.statusValidacao in ['REJEITADO', 'EM_ANALISE'] &&
         request.resource.data.statusValidacao == 'EM_ANALISE');

      allow delete: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
    }

    // VEÍCULOS
    match /veiculos/{veiculoId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.motoristaId;
    }

    // PASSAGEIROS
    match /passageiros/{passageiroId} {
      allow create: if request.auth != null
                        && request.resource.data.responsavelId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                        && resource.data.responsavelId == request.auth.uid;
    }

    // LOCAIS (pontos de embarque)
    match /locais/{localId} {
      allow create: if request.auth != null
                        && request.resource.data.responsavelId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                        && resource.data.responsavelId == request.auth.uid;
    }

    // LOCALIZAÇÕES (rastreamento em tempo real) — um documento por viagem
    // (localizacoes/{viagemId}, sempre sobrescrito), com motoristaId e
    // responsaveisAutorizados denormalizados nele mesmo, no mesmo espírito
    // de "viagens", pra não depender de getAfter() numa escrita de alta
    // frequência.
    match /localizacoes/{viagemId} {
      allow read: if logado() && (
        request.auth.uid == resource.data.motoristaId ||
        request.auth.uid in resource.data.responsaveisAutorizados ||
        ehAdmin()
      );

      allow write: if logado() && request.auth.uid == request.resource.data.motoristaId;
    }

    // CHAT
    match /chats/{chatId} {
      allow read, write: if request.auth != null
                        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
                        && request.auth.uid in request.resource.data.participantes;

      match /mensagens/{mensagemId} {
        allow read, write: if request.auth != null;
      }
    }

    // ===================================================================
    // ROTAS (criar exige assinatura em dia)
    // ===================================================================
    match /rotas/{rotaId} {
      allow read: if request.auth != null;
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        assinaturaOperacional(request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.motoristaId == request.auth.uid;
    }

    match /paradas_rota/{paradaId} {
      allow read, write: if request.auth != null;
    }

    // ===================================================================
    // SOLICITAÇÕES DE INCLUSÃO (aceitar exige assinatura em dia)
    // ===================================================================
    match /solicitacoes_inclusao/{solicitacaoId} {
      // Quem pede (responsável) e quem recebe (motorista).
      allow read: if logado() &&
        (resource.data.responsavelId == request.auth.uid ||
         resource.data.motoristaId == request.auth.uid);

      // Só é possível pedir vaga a um motorista com assinatura em dia.
      allow create: if logado() &&
        request.resource.data.responsavelId == request.auth.uid &&
        request.resource.data.status == 'PENDENTE' &&
        assinaturaOperacional(request.resource.data.motoristaId);

      // As duas partes podem atualizar (como antes), mas aceitar só é
      // possível se o motorista estiver com a assinatura em dia.
      allow update: if logado() &&
        (resource.data.motoristaId == request.auth.uid ||
         resource.data.responsavelId == request.auth.uid) &&
        (request.resource.data.status != 'ACEITA' ||
         assinaturaOperacional(resource.data.motoristaId));
    }

    // ===================================================================
    // PLANOS E ASSINATURAS
    // ===================================================================

    // Assinatura do motorista (id do documento = uid do motorista)
    match /assinaturas/{motoristaId} {
      // Leitura individual liberada: o app do responsável precisa saber se o
      // motorista está em dia para mostrar a rota na busca.
      allow get: if logado();
      allow list: if ehAdmin();

      allow create, update: if logado() &&
        ((request.auth.uid == motoristaId &&
          request.resource.data.motoristaId == motoristaId) || ehAdmin());

      allow delete: if false;

      match /historico/{eventoId} {
        allow read: if logado() && (request.auth.uid == motoristaId || ehAdmin());
        allow create: if logado() && request.auth.uid == motoristaId;
        allow update, delete: if false;
      }
    }

    // Cobranças (mensalidades e upgrades)
    match /pagamentos/{pagamentoId} {
      allow read: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid;
      allow update: if logado() &&
        (resource.data.motoristaId == request.auth.uid || ehAdmin());
      allow delete: if false;
    }

    // Catálogo de planos: todos leem, só o admin altera.
    match /planos/{planoId} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    // ===== PAINEL ADMIN =====
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // ===================================================================
    // VIAGENS (execução de uma rota) e PARADAS/EVENTOS dessa viagem
    // ===================================================================

    // Iniciar viagem também exige assinatura em dia, pelo mesmo motivo de
    // "rotas": sem isso, um motorista inadimplente continuaria rodando.
    match /viagens/{viagemId} {
      allow read: if logado() && (
        request.auth.uid == resource.data.motoristaId ||
        request.auth.uid in resource.data.responsaveisAutorizados ||
        ehAdmin()
      );

      allow create: if logado() &&
        request.resource.data.motoristaId == request.auth.uid &&
        assinaturaOperacional(request.auth.uid);

      // Atualizações do dia a dia (pausar/retomar/avançar parada/finalizar)
      // não exigem assinatura em dia: não dá para abandonar crianças no meio
      // da rota por causa de uma cobrança atrasada no meio da viagem.
      allow update: if logado() && request.auth.uid == resource.data.motoristaId;

      allow delete: if false; // histórico, não se apaga pelo app
    }

    match /paradas_viagem/{paradaId} {
      // Responsável só lê a(s) parada(s) do(s) próprio(s) filho(s); o
      // motorista da viagem lê todas. getAfter() porque a viagem é criada
      // no mesmo batch que as paradas.
      allow read: if logado() && (
        request.auth.uid == resource.data.responsavelId ||
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(resource.data.viagemId)).data.motoristaId ||
        ehAdmin()
      );

      allow create, update: if logado() &&
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(request.resource.data.viagemId)).data.motoristaId;

      allow delete: if false;
    }

    match /eventos_viagem/{eventoId} {
      // Conservador por enquanto: só o motorista (e admin) lê. Decidimos o
      // acesso do responsável na Etapa 5, quando as notificações realmente
      // consumirem isso.
      allow read: if logado() && (
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(resource.data.viagemId)).data.motoristaId ||
        ehAdmin()
      );

      allow create: if logado() &&
        request.auth.uid == getAfter(/databases/$(database)/documents/viagens/$(request.resource.data.viagemId)).data.motoristaId;

      allow update, delete: if false;
    }
  }
}
