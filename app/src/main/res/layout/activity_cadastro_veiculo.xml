<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro/edição de veículo, no mesmo desenho do perfil do passageiro:
     barra com voltar, foto de exemplo do modelo centralizada com nome e placa,
     e duas abas — Informações (formulário + Salvar) e Documentos (CRLV e
     autorização, com o selo de status; tocar abre o envio). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/conteudoCadastroVeiculo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- BARRA DO TOPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnVoltarCadastroVeiculo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrowback"
                app:tint="@color/text_primary"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtTituloVeiculo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Novo veículo"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollCadastroVeiculo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <!-- CABEÇALHO: FOTO DE EXEMPLO + NOME + PLACA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="130dp">

                        <ImageView
                            android:id="@+id/imgFotoVeiculo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="10dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Foto de exemplo do modelo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/van1_img"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/txtStatusFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_gravity="bottom|center"
                            android:gravity="center"
                            android:textColor="@color/text_tertiary"
                            android:textSize="8sp"
                            tools:text="Foto de exemplo do modelo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtNomeVeiculoCabecalho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Mercedes Sprinter" />

                        <TextView
                            android:id="@+id/txtSubtituloVeiculo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="ABC1D23" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ABAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/abaInformacoesVeiculo"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_aba_escura_selecionada"
                        android:gravity="center"
                        android:text="Informações"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/abaDocumentosVeiculo"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_aba"
                        android:gravity="center"
                        android:text="Documentos"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- ================= ABA INFORMAÇÕES ================= -->
                <LinearLayout
                    android:id="@+id/conteudoInformacoesVeiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="20dp">

                    <!-- PLACA -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Placa" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPlaca"
                        style="@style/CaixaEdicaoPerfil">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPlaca"
                            style="@style/TextoEdicaoPerfil"
                            android:hint="ABC1D23"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroPlaca"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Digite uma placa válida (ABC1234 ou ABC1D23)." />

                    <!-- MARCA / MODELO -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Marca" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMarca"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtMarca"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            android:focusable="false"
                            android:hint="Selecione a marca"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroMarca"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha a marca do veículo." />

                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Modelo" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutModelo"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtModelo"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            android:focusable="false"
                            android:hint="Selecione o modelo"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroModelo"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha o modelo do veículo." />

                    <!-- ANO / CAPACIDADE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RotuloEdicaoPerfil"
                                android:text="Ano" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutAno"
                                style="@style/CaixaEdicaoPerfil">

                                <AutoCompleteTextView
                                    android:id="@+id/edtAno"
                                    style="@style/TextoEdicaoPerfil"
                                    android:cursorVisible="false"
                                    android:drawableEnd="@drawable/ic_seta_baixo"
                                    android:focusable="false"
                                    android:hint="Ano"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/txtErroAno"
                                style="@style/ErroEdicaoPerfil"
                                android:text="*Ano inválido." />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RotuloEdicaoPerfil"
                                android:text="Lugares" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutCapacidade"
                                style="@style/CaixaEdicaoPerfil">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtCapacidade"
                                    style="@style/TextoEdicaoPerfil"
                                    android:hint="Passageiros"
                                    android:inputType="number"
                                    android:maxLength="2" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/txtErroCapacidade"
                                style="@style/ErroEdicaoPerfil"
                                android:text="*Entre 1 e 40." />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- COR -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Cor" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCor"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtCor"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            android:drawablePadding="10dp"
                            android:focusable="false"
                            android:hint="Selecione a cor"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroCor"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha a cor do veículo." />
                </LinearLayout>

                <!-- Excluir (só na edição, aba Informações) — como no perfil do passageiro -->
                <TextView
                    android:id="@+id/btnExcluirVeiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Excluir veículo"
                    android:textColor="@color/status_danger"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText"
                    tools:visibility="visible" />

                <!-- ================= ABA DOCUMENTOS ================= -->
                <LinearLayout
                    android:id="@+id/conteudoDocumentosVeiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Veículo ainda não salvo: os documentos dependem dele -->
                    <TextView
                        android:id="@+id/txtDocumentosSemVeiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_tile_rota"
                        android:backgroundTint="@color/status_warning_fundo"
                        android:lineSpacingExtra="2dp"
                        android:padding="14dp"
                        android:text="Salve as informações do veículo para poder enviar os documentos."
                        android:textColor="@color/status_warning_texto"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText"
                        tools:visibility="visible" />

                    <!-- CRLV -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/itemCrlvVeiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_container"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:id="@+id/iconeCrlvVeiculo"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icone_motorista"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_enviar_arquivo"
                                app:tint="@color/rota_destaque" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="CRLV"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Certificado de Registro e Licenciamento do Veículo"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    tools:ignore="HardcodedText" />

                                <TextView
                                    android:id="@+id/txtStatusCrlvVeiculo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/bg_pilula_branca"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Em análise" />

                                <TextView
                                    android:id="@+id/txtMotivoCrlvVeiculo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/status_danger"
                                    android:textSize="13sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_direita"
                                app:tint="@color/text_tertiary" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- AUTORIZAÇÃO -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/itemAutorizacaoVeiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_container"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:id="@+id/iconeAutorizacaoVeiculo"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icone_motorista"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_enviar_arquivo"
                                app:tint="@color/rota_destaque" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Autorização de transporte escolar"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Liberação para dirigir transporte escolar"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    tools:ignore="HardcodedText" />

                                <TextView
                                    android:id="@+id/txtStatusAutorizacaoVeiculo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/bg_pilula_branca"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Pendente" />

                                <TextView
                                    android:id="@+id/txtMotivoAutorizacaoVeiculo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/status_danger"
                                    android:textSize="13sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_direita"
                                app:tint="@color/text_tertiary" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- DICA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_icone_motorista"
                        android:backgroundTint="@color/rota_vagas_fundo"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dica"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Envie uma foto legível ou o PDF de cada documento. Depois de enviados, eles passam por análise."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Salvar (só na aba Informações) -->
        <FrameLayout
            android:id="@+id/rodapeSalvarVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/rodape_salvar_edicao_perfil" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
