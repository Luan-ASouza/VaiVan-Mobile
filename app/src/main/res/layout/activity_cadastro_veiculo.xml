<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro/edição de veículo: cabeçalho escuro com a foto da van em destaque
     e, abaixo, o formulário no mesmo estilo das telas de perfil. O cabeçalho
     rola junto com o formulário; o voltar e o botão Salvar ficam fixos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/conteudoCadastroVeiculo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================= CABEÇALHO ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_veiculo"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/topGap"
                        android:layout_width="match_parent"
                        android:layout_height="0dp" />

                    <!-- espaço do botão voltar (que fica fixo por cima) -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="64dp" />

                    <TextView
                        android:id="@+id/txtTituloVeiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold"
                        android:paddingHorizontal="24dp"
                        android:text="Novo veículo"
                        android:textColor="@color/text_on_dark"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/txtSubtituloVeiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="24dp"
                        android:text="Última etapa antes de começar a rodar. Escolha o modelo e veja a sua van."
                        android:textColor="@color/text_on_dark_secondary"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <!-- sombra no chão, sob a van -->
                        <View
                            android:layout_width="260dp"
                            android:layout_height="22dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_sombra_chao" />

                        <ImageView
                            android:id="@+id/imgFotoVeiculo"
                            android:layout_width="match_parent"
                            android:layout_height="210dp"
                            android:layout_marginHorizontal="12dp"
                            android:alpha="0.35"
                            android:contentDescription="Foto do veículo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/van1_img" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtStatusFoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="24dp"
                        android:text="Escolha marca e modelo pra ver uma foto de exemplo"
                        android:textColor="@color/text_on_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ================= FORMULÁRIO ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <!-- PLACA -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Placa" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPlaca"
                        style="@style/CaixaEdicaoPerfil">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPlaca"
                            style="@style/TextoEdicaoPerfil"
                            android:hint="ABC1D23"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroPlaca"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Digite uma placa válida (ABC1234 ou ABC1D23)." />

                    <!-- MARCA / MODELO -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Marca" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMarca"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtMarca"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="Selecione a marca"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroMarca"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha a marca do veículo." />

                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Modelo" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutModelo"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtModelo"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="Selecione o modelo"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroModelo"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha o modelo do veículo." />

                    <!-- ANO / CAPACIDADE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RotuloEdicaoPerfil"
                                android:text="Ano" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutAno"
                                style="@style/CaixaEdicaoPerfil">

                                <AutoCompleteTextView
                                    android:id="@+id/edtAno"
                                    android:drawableEnd="@drawable/ic_seta_baixo"
                                    style="@style/TextoEdicaoPerfil"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:hint="Ano"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/txtErroAno"
                                style="@style/ErroEdicaoPerfil"
                                android:text="*Ano inválido." />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RotuloEdicaoPerfil"
                                android:text="Lugares" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutCapacidade"
                                style="@style/CaixaEdicaoPerfil">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtCapacidade"
                                    style="@style/TextoEdicaoPerfil"
                                    android:hint="Passageiros"
                                    android:inputType="number"
                                    android:maxLength="2" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/txtErroCapacidade"
                                style="@style/ErroEdicaoPerfil"
                                android:text="*Entre 1 e 40." />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- COR -->
                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Cor" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCor"
                        style="@style/CaixaEdicaoPerfil">

                        <AutoCompleteTextView
                            android:id="@+id/edtCor"
                            android:drawableEnd="@drawable/ic_seta_baixo"
                            style="@style/TextoEdicaoPerfil"
                            android:cursorVisible="false"
                            android:drawablePadding="10dp"
                            android:focusable="false"
                            android:hint="Selecione a cor"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtErroCor"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Escolha a cor do veículo." />

                    <!-- DOCUMENTOS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="Documentos"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Envie uma foto ou o PDF de cada documento."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- CRLV -->
                    <LinearLayout
                        android:id="@+id/btnSelecionarCrlv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_beige_round_20"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_documento"
                            app:tint="@color/text_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CRLV"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Certificado de Registro e Licenciamento do Veículo"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtNomeArquivoCrlv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:text="Toque para selecionar"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconCheckCrlv"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_check"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtErroCrlv"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Selecione o arquivo do CRLV." />

                    <!-- AUTORIZAÇÃO -->
                    <LinearLayout
                        android:id="@+id/btnSelecionarAutorizacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_beige_round_20"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_documento"
                            app:tint="@color/text_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Autorização de transporte escolar"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Documento de liberação para dirigir transporte escolar"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtNomeArquivoAutorizacao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:text="Toque para selecionar"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconCheckAutorizacao"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_check"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtErroAutorizacao"
                        style="@style/ErroEdicaoPerfil"
                        android:text="*Selecione o documento de autorização." />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include layout="@layout/rodape_salvar_edicao_perfil" />
    </LinearLayout>

    <!-- Voltar fixo por cima do cabeçalho (a margem do topo acompanha a status bar). -->
    <ImageButton
        android:id="@+id/btnVoltarCadastroVeiculo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_botao_voltar_hero"
        android:contentDescription="Voltar"
        android:src="@drawable/ic_arrowback"
        app:tint="@color/text_on_dark" />

</FrameLayout>
