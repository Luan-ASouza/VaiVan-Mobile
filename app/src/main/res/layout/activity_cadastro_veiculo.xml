<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- CABEÇALHO PRETO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingHorizontal="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_truck"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre seu veículo"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Última etapa antes de começar a rodar"
            android:textColor="@color/orange"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- CARD: DADOS DO VEÍCULO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dados do veículo"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- PLACA -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPlaca"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/orange"
                        app:hintTextColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPlaca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Placa (ABC1D23)"
                            android:maxLength="8"
                            android:inputType="textCapCharacters" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/txtErroPlaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Digite uma placa válida"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- MARCA -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/orange"
                        app:hintTextColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtMarca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Marca (ex: Fiat, Mercedes-Benz)" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/txtErroMarca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Digite a marca do veículo"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- MODELO -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/orange"
                        app:hintTextColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtModelo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Modelo (ex: Fiat Ducato)" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/txtErroModelo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Digite o modelo do veículo"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- ANO + CAPACIDADE lado a lado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                app:boxStrokeColor="@color/orange"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtAno"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Ano"
                                    android:inputType="number"
                                    android:maxLength="4" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView
                                android:id="@+id/txtErroAno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="*Ano inválido"
                                android:textColor="@color/red"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                app:boxStrokeColor="@color/orange"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtCapacidade"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Capacidade"
                                    android:inputType="number"
                                    android:maxLength="2" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView
                                android:id="@+id/txtErroCapacidade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="*Obrigatório"
                                android:textColor="@color/red"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- COR -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/orange"
                        app:hintTextColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Cor" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/txtErroCor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Digite a cor do veículo"
                        android:textColor="@color/red"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: DOCUMENTOS DO VEÍCULO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documentos do veículo"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Envie foto ou PDF de cada documento"
                        android:textColor="@color/light_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="18dp" />

                    <!-- BLOCO CRLV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_beige_round_20"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CRLV"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Certificado de Registro e Licenciamento do Veículo"
                            android:textColor="@color/light_gray"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnSelecionarCrlv"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_button_yellow"
                                android:backgroundTint="@null"
                                android:text="Selecionar arquivo"
                                android:textAllCaps="false"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/iconCheckCrlv"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_check"
                                android:layout_marginStart="10dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtNomeArquivoCrlv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nenhum arquivo selecionado"
                            android:textColor="@color/light_gray"
                            android:textStyle="italic"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="middle"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- BLOCO AUTORIZAÇÃO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_beige_round_20"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Autorização de Transporte Escolar"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Documento de liberação para dirigir transporte escolar"
                            android:textColor="@color/light_gray"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnSelecionarAutorizacao"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_button_yellow"
                                android:backgroundTint="@null"
                                android:text="Selecionar arquivo"
                                android:textAllCaps="false"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/iconCheckAutorizacao"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_check"
                                android:layout_marginStart="10dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtNomeArquivoAutorizacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nenhum arquivo selecionado"
                            android:textColor="@color/light_gray"
                            android:textStyle="italic"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="middle"
                            android:singleLine="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÃO PRINCIPAL -->
            <Button
                android:id="@+id/btnSalvarVeiculo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_button_darkgrey"
                android:backgroundTint="@null"
                android:text="Salvar e continuar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>