<?xml version="1.0" encoding="utf-8"?>
<!-- Aluno confirmado na rota (aba Alunos do detalhe): ordem de embarque,
     foto, nome, endereço e o botão de conversar com o responsável. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoAlunoRota"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_01"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <TextView
                android:id="@+id/txtOrdemAlunoRota"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circulo_escuro"
                android:gravity="center"
                android:textColor="@color/text_on_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="1" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeAlunoRota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Lucas Santos" />

            <TextView
                android:id="@+id/txtEnderecoAlunoRota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="R. Almerinda Ramos Santos, 92" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChatAlunoRota"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circulo_escuro"
            android:contentDescription="Conversar com o responsável"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chat"
            app:tint="@color/text_on_dark"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
