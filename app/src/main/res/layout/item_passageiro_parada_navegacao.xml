<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_container_round_30"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fotoProgressoPassageiro"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/filho1"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/dark_gray"
            app:strokeWidth="3dp" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nomePassageiroItemParada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusPassageiroItemParada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/botoesPassageiroItemParada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNaoAcaoItemParada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:backgroundTint="@color/status_danger"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarAcaoItemParada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/status_success"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
