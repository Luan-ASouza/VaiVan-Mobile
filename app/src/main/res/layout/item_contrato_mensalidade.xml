<?xml version="1.0" encoding="utf-8"?>
<!-- Um passageiro na tela de Pagamentos do motorista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_withe_round_10"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtNomePassageiroContrato"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Maria Souza" />

        <TextView
            android:id="@+id/txtSituacaoContrato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_situacao"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:backgroundTint="@color/green"
            tools:text="Em dia" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtResponsavelContrato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/medium_gray"
        android:textSize="13sp"
        tools:text="Responsável: Ana Souza · La Salle - Manhã" />

    <TextView
        android:id="@+id/txtValorContrato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/dark_gray"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="R$ 400,00 / mês · vence dia 10" />

    <TextView
        android:id="@+id/txtDetalheContrato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/gray"
        android:textSize="13sp"
        tools:text="Próxima cobrança: 10/12/2026" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcaoContrato"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Registrar recebimento"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/dark_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoricoContrato"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Histórico"
            android:textAllCaps="false"
            android:textColor="@color/dark_gray"
            android:textSize="13sp"
            app:strokeColor="@color/dark_gray" />
    </LinearLayout>
</LinearLayout>
