<?xml version="1.0" encoding="utf-8"?>
<!-- Um local salvo: ícone num quadrinho (cor do perfil), nome, endereço e o
     lápis de editar. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/imgIconeLocal"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icone_responsavel"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_local"
            app:tint="@color/passageiro_destaque_forte" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeLocalSalvo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Casa" />

            <TextView
                android:id="@+id/txtEnderecoLocalSalvo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Rua das Flores, 123 - Centro" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditarLocalSalvo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar local"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_editar"
            app:tint="@color/text_secondary"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
