<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fontFamily="@font/montserrat">

    <ScrollView
        android:id="@+id/scrollComprovanteResidencia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/dark_gray"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_marginVertical="10dp"
            android:background="@drawable/bg_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprovante de residência"
                android:textColor="@color/dark_gray"
                android:textSize="30sp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp" />

            <!-- TEXTO EXPLICATIVO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Envie um documento que comprove seu endereço de residência."
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:text="O documento deve estar em seu nome e ter sido emitido nos últimos 90 dias."
                android:textAlignment="center"
                android:textColor="#111111"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/containerPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp"
                android:background="@drawable/bg_white">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Exemplos aceitos:"
                    android:textAlignment="center"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="- Conta de luz, água ou internet
                \n- Fatura de telefone
                \n- Documento bancário
                \n- Outros documentos oficiais com seu endereço"
                    android:textColor="#111111"
                    android:textSize="13sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingHorizontal="30dp">

                <!-- LABEL FOTO DA FRENTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto da frente"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- LINHA COM BOTÃO EDITAR ENVIO E NOME DO ARQUIVO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <!-- BOTÃO EDITAR ENVIO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnviarArquivoComprovante"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_hollow_blackborder"
                        app:backgroundTint="@null"
                        android:text="Selecionar Arquivo"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_gray"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <!-- NOME DO ARQUIVO ENVIADO -->
                    <TextView
                        android:id="@+id/txtNomeArquivoComprovante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/dark_gray"
                        android:textSize="13sp"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- LABEL FOTO DO VERSO -->


                <!-- BOTÃO PRINCIPAL ENVIAR E CONTINUAR -->

            </LinearLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:text="Certifique-se de que o documento esteja legível e que todas as informações estejam visíveis."
                android:textAlignment="center"
                android:textColor="@color/orange"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEnviarContinuarComprovante"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/btn_black_white_selector"
                app:backgroundTint="@null"
                android:text="Enviar e Continuar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

    </ScrollView>
</LinearLayout>