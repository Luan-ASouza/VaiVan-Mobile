<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollComprovanteResidencia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_solitude"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:fontFamily="@font/montserrat">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comprovante de residência"
            android:textAlignment="center"
            android:textColor="#202124"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- DESCRIÇÃO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Envie um documento que comprove seu endereço de residência."
            android:textColor="#686D75"
            android:textSize="14sp" />

        <!-- INFORMAÇÕES DO DOCUMENTO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_container_round_30"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requisitos do documento"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="O documento deve estar em seu nome e ter sido emitido nos últimos 90 dias."
                android:textColor="#686D75"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Exemplos aceitos:"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Conta de luz, água ou internet&#10;• Fatura de telefone&#10;• Documento bancário&#10;• Outros documentos oficiais com seu endereço"
                android:textColor="#686D75"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- SEÇÃO DE UPLOAD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="Comprovante de residência"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- CONTAINER DE SELEÇÃO E PROGRESSO -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <!-- ÁREA PONTILHADA INICIAL -->

            <LinearLayout
                android:id="@+id/btnSelecionarComprovante"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_file_upload">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:contentDescription="Selecionar comprovante" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enviar comprovante"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toque aqui para tirar uma foto ou selecionar um arquivo"
                    android:textAlignment="center"
                    android:textColor="#686D75"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- CARTÃO DO ARQUIVO SELECIONADO -->

            <include
                android:id="@+id/itemComprovante"
                layout="@layout/item_arquivo_cnh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </FrameLayout>

        <!-- AVISO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Certifique-se de que o documento esteja legível e que todas as informações estejam visíveis."
            android:textColor="#686D75"
            android:textSize="13sp" />

        <!-- STATUS GERAL -->

        <TextView
            android:id="@+id/txtStatusGeral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Selecione um documento para começar."
            android:textColor="#686D75"
            android:textSize="13sp" />

        <!-- BOTÃO CONTINUAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarContinuarComprovante"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Envie o documento"
            android:textAllCaps="false"
            android:textColor="#202124"
            android:textStyle="bold"
            android:enabled="false"
            app:backgroundTint="#F6B12F"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>