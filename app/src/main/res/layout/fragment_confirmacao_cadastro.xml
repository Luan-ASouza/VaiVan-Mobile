<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F6B12F"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white"
            android:paddingHorizontal="20dp"
            android:paddingVertical="32dp">

            <include layout="@layout/stepper_cadastro" />

            <!-- TÍTULO -->

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Quase lá"
                android:textColor="@color/dark_gray"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- DESCRIÇÃO -->

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:text="Confira seus dados antes de finalizar o cadastro."
                android:textColor="@color/light_gray"
                android:textSize="13sp"/>


            <!-- ========================= -->
            <!-- DADOS PESSOAIS -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dados pessoais"
                android:textColor="@color/dark_gray"
                android:textSize="15sp"
                android:textStyle="bold"/>


            <!-- NOME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nome completo"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- CPF -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CPF"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtCpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- DATA DE NASCIMENTO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Data de nascimento"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtDataNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- E-MAIL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="E-mail"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- TELEFONE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Telefone"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- ========================= -->
            <!-- ENDEREÇO -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Endereço"
                android:textColor="@color/dark_gray"
                android:textSize="15sp"
                android:textStyle="bold"/>


            <!-- CEP -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CEP"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtCep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- CIDADE / ESTADO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Cidade / Estado"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtCidadeEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- RUA / NÚMERO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Rua / Número"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtRuaNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- BAIRRO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Bairro"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtBairro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- COMPLEMENTO -->

            <TextView
                android:id="@+id/txtLabelComplemento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Complemento"
                android:textColor="@color/light_gray"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtComplemento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- CONSENTIMENTOS -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:background="#EFEBE4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkTermos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <TextView
                    android:id="@+id/txtTermos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Li e aceito os Termos de Uso"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtErroTermos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="*É preciso aceitar os Termos de Uso"
                android:textColor="#F40707"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkComunicacoes"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Quero receber novidades e comunicados por e-mail"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- ERRO -->

            <TextView
                android:id="@+id/txtErro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="*Erro ao criar a conta."
                android:textColor="#F40707"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"/>


            <!-- BOTÃO -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_gray_filled"
                android:text="Criar conta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>