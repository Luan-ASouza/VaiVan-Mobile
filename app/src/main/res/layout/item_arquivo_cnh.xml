<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#EAF0F2"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#AEB9BE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Informações do arquivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtIconeArquivo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="IMG"
                android:textColor="#202124"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_icone_arquivo_cnh" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomeArquivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenhum arquivo selecionado"
                    android:textColor="#202124"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/txtEstadoArquivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Aguardando arquivo"
                    android:textColor="#686D75"
                    android:textSize="11sp"
                    android:maxLines="2" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtProgressoArquivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="#168B70"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnExcluirArquivo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir arquivo enviado"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_danger"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Progresso do upload -->
        <ProgressBar
            android:id="@+id/progressoArquivo"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/status_success"
            android:background="@drawable/bg_container_round_30"
            android:progressBackgroundTint="#D5DFE2" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
