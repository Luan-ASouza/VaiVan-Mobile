<?xml version="1.0" encoding="utf-8"?>
<!-- Topo do cartão de cada etapa do cadastro: voltar + barra de progresso
     (pílula laranja vazada). Configurado por configurarEtapaCadastro(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_hollow_orange"
        android:padding="2dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressEtapaCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/orange_light"
            app:trackColor="@android:color/transparent"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp"
            app:trackStopIndicatorSize="0dp"
            app:indicatorTrackGapSize="0dp" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnVoltarEtapa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:src="@drawable/ic_arrowback"
        app:tint="@color/text_primary" />

</LinearLayout>
