<?xml version="1.0" encoding="utf-8"?>
<!-- Criação (passo a passo, um campo por vez) e edição de um campo da rota.
     Topo escuro com o título do campo; o campo fica numa folha branca
     minimalista, como nas telas de edição do perfil. Só um "painel" fica
     visível por vez (em código, conforme o campo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rota_destaque"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- TOPO ESCURO: voltar, passo, título e descrição do campo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVoltarEdicaoPerfil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrowback"
                app:tint="@color/text_on_dark"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtPassoCriarRota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Passo 2 de 8" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressPassosCriarRota"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="8"
            android:progressBackgroundTint="@color/gray"
            android:progressTint="@color/color_primary"
            tools:progress="2" />

        <TextView
            android:id="@+id/txtTituloCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_on_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Nome da rota" />

        <TextView
            android:id="@+id/txtDescricaoCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="14sp"
            tools:text="Como a rota aparece para você e para os responsáveis." />
    </LinearLayout>

    <!-- FOLHA BRANCA: o campo + o botão (sobe com o teclado) -->
    <LinearLayout
        android:id="@+id/conteudoEdicaoPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_folha_branca"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="12dp">

                <!-- TEXTO (nome, capacidade) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCampo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_white"
                    android:visibility="gone"
                    app:boxBackgroundMode="none"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCampo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:minHeight="52dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ESCOLHA ÚNICA (sentido, turno) -->
                <LinearLayout
                    android:id="@+id/painelOpcoesCriarRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- DIAS DA SEMANA -->
                <LinearLayout
                    android:id="@+id/painelDiasCriarRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/containerDiasCriarRota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnDiasUteisCriarRota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tile_rota"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="Seg a Sex"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/btnTodosDiasCriarRota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tile_rota"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="Todos os dias"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

                <!-- LOCAL (escola, ponto de embarque/desembarque) -->
                <LinearLayout
                    android:id="@+id/painelLocalCriarRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_rota"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/imgLocalCriarRota"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circulo_escuro"
                            android:importantForAccessibility="no"
                            android:padding="11dp"
                            android:src="@drawable/ic_local"
                            app:tint="@color/text_on_dark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtLocalCriarRota"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Escola Municipal" />

                            <TextView
                                android:id="@+id/txtEnderecoLocalCriarRota"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="Av. Rio Branco, 450 - Centro" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscolherLocalCriarRota"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/background_container"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/rota_destaque"
                        app:strokeWidth="1dp"
                        tools:text="Escolher no mapa" />
                </LinearLayout>

                <!-- BAIRROS ATENDIDOS -->
                <LinearLayout
                    android:id="@+id/painelBairrosCriarRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBairrosCriarRota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp" />

                    <TextView
                        android:id="@+id/txtSemBairrosCriarRota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_rota"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Nenhum bairro adicionado"
                        android:textColor="@color/text_tertiary"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdicionarBairroCriarRota"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Adicionar bairro pelo mapa"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/background_container"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_primary"
                        app:strokeColor="@color/rota_destaque"
                        app:strokeWidth="1dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtErroCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/status_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtNotaCriarRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Mudar este ponto recalcula o trajeto da rota."
                    tools:visibility="visible" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/rodape_salvar_edicao_perfil" />
    </LinearLayout>
</LinearLayout>
