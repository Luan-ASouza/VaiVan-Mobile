<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_gray"
        android:fillViewport="true"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"> <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVoltar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrowback"
                    app:tint="@color/dark_gray" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Nova Rota"
                    android:textColor="@color/dark_gray"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout> <!-- NOME DA ROTA --> <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome da rota"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_white"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNomeRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: La Salle Carmo - Manhã"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/dark_gray"
                    android:textColorHint="@color/light_gray"
                    android:textSize="14sp"
                    tools:ignore="Autofill" />
            </com.google.android.material.textfield.TextInputLayout> <!-- ORIGEM --> <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ponto de partida"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/background_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtOrigemAtual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhum ponto definido"
                        android:textColor="@color/light_gray"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDefinirOrigem"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_gray_filled"
                        android:text="Definir no mapa"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView> <!-- DESTINO --> <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Destino"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/background_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtDestinoAtual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhum destino definido"
                        android:textColor="@color/light_gray"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDefinirDestino"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_gray_filled"
                        android:text="Definir no mapa"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView> <!-- TURNO --> <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Turno"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManha"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Manhã"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTarde"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Tarde"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNoite"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Noite"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- DIAS DA SEMANA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Dias da semana"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeg"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Seg"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Ter"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQua"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Qua"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQui"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Qui"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSex"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Sex"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSab"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Sáb"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDom"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Dom"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/button_toggle_background" />

            </com.google.android.material.button.MaterialButtonToggleGroup> <!-- CAPACIDADE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Capacidade"
                android:textColor="@color/dark_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_white"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCapacidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: 15 vagas"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/dark_gray"
                    android:textColorHint="@color/light_gray"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BOTÃO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarRota"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Criar rota"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/dark_gray"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>