<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="220dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_cadastro_card"
            android:elevation="12dp"
            android:paddingHorizontal="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">

            <include layout="@layout/stepper_cadastro" />

            <TextView
                android:layout_marginTop="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirme seu e-mail"
                android:textColor="@color/dark_gray"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescricaoVerificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Mandamos um link de confirmação pro seu e-mail. Abra seu e-mail, toque no link e volte aqui."
                android:textColor="@color/light_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtErroVerificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="*Ainda não detectamos a confirmação. Verifique seu e-mail (inclusive a caixa de spam) e tente de novo."
                android:textColor="@color/status_danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJaVerifiquei"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_gray_filled"
                android:text="Já verifiquei"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/txtReenviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Reenviar e-mail"
                android:textColor="@color/dark_gray"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>
