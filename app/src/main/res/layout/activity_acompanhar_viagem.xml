<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_container">

    <!-- MAPA em tela cheia, por trás da status bar (o topGap é transparente),
         pra tela ficar "aberta" como em apps de transporte. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Leve degradê no topo pra os ícones da status bar não brigarem com o mapa -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scrim_topo_mapa"
        app:layout_constraintBottom_toBottomOf="@id/topGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TOP GAP -->
    <View
        android:id="@+id/topGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTTOM GAP (mesma cor do sheet, emenda com ele) -->
    <View
        android:id="@+id/bottomGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ÁREA ÚTIL: botões flutuantes + bottom sheet por cima do mapa -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootAcompanharViagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGap">

        <!-- Voltar — ancorado no topo do sheet, à esquerda (acompanha o arraste) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFecharAcompanhar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrowback"
            app:backgroundTint="@color/background_container"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:layout_anchor="@id/cardStatusAcompanhar"
            app:layout_anchorGravity="top|start"
            app:maxImageSize="18dp"
            app:tint="@color/text_primary" />

        <!-- Retomar recentralização automática (só aparece depois que o
             responsável arrasta o mapa manualmente) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnRetomarRecentralizacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="Retomar recentralização automática"
            android:src="@drawable/ic_mylocation"
            android:visibility="gone"
            app:backgroundTint="@color/background_container"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:layout_anchor="@id/cardStatusAcompanhar"
            app:layout_anchorGravity="top|end"
            app:maxImageSize="22dp"
            app:tint="@color/text_primary" />

        <!-- ================================================== -->
        <!-- BOTTOM SHEET                                        -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusAcompanhar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_hideable="false"
            app:behavior_peekHeight="184dp"
            app:cardBackgroundColor="@color/background_container"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:layout_behavior="@string/bottom_sheet_behavior"
            app:strokeWidth="0dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="28dp">

                    <!-- ALÇA DE ARRASTE -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_sheet_handle" />

                    <!-- ===== VISÍVEL RECOLHIDO ===== -->

                    <!-- STATUS DA VIAGEM (título) + CHIP DO ALUNO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtStatusViagemAcompanhar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            tools:text="A caminho da escola" />

                        <TextView
                            android:id="@+id/txtStatusAlunoAcompanhar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_chip_status_passageiro"
                            android:fontFamily="@font/montserrat_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            tools:text="Na van" />

                    </LinearLayout>

                    <!-- ETA DO PONTO DO FILHO -->
                    <TextView
                        android:id="@+id/txtEtaAcompanhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Chegada estimada às 07:42"
                        tools:visibility="visible" />

                    <!-- MOTORISTA + PLACA + ROTA, com atalho do chat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/fotoMotoristaAcompanhar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_perfil"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtMotoristaAcompanhar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/montserrat_semibold"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="João Silva · ABC-1234" />

                            <TextView
                                android:id="@+id/txtNomeRotaAcompanhar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="Colégio Sagrado - Manhã" />

                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnAbrirChatAcompanhar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_botao_redondo_claro"
                            android:contentDescription="Conversar com o motorista"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/text_primary" />

                    </LinearLayout>

                    <!-- ===== SÓ VISÍVEL EXPANDIDO ===== -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/background_screen" />

                    <!-- ALUNO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/fotoAlunoAcompanhar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_perfil"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="@color/color_primary"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/txtNomeAlunoAcompanhar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="Maria" />

                    </LinearLayout>

                    <!-- TRAJETO: próximo ponto do filho → desembarque final -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_secao_sheet"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <!-- Trilho: ponto, linha, ponto -->
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_ponto_rota_primario" />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="0dp"
                                android:layout_marginVertical="4dp"
                                android:layout_weight="1"
                                android:background="@color/light_graysh" />

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_ponto_rota_escuro" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Próximo ponto"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/txtEnderecoAcompanhar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                tools:text="Rua Exemplo, 123" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:text="Desembarque final"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/txtDesembarqueFinalAcompanhar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                tools:text="Colégio Sagrado" />

                            <TextView
                                android:id="@+id/txtEtaFinalAcompanhar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Previsão às 07:55"
                                tools:visibility="visible" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- AVISO DE AUSÊNCIA (preenchido em código — ver AcompanharViagemActivity) -->
                    <LinearLayout
                        android:id="@+id/containerAvisoAusenciaAcompanhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
