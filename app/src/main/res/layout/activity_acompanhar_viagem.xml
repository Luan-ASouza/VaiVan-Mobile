<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray">

    <!-- TOP GAP -->
    <View
        android:id="@+id/topGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dark_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTTOM GAP -->
    <View
        android:id="@+id/bottomGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dark_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGap" />

    <!-- Fechar a tela -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnFecharAcompanhar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Fechar"
        android:src="@drawable/ic_arrowback"
        app:backgroundTint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGap"
        app:maxImageSize="20dp" />

    <!-- Header: nome da viagem + motorista + placa -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeaderAcompanhar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnFecharAcompanhar"
        app:layout_constraintTop_toTopOf="@id/btnFecharAcompanhar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/txtNomeRotaAcompanhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#101010"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Colégio Sagrado - Manhã" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fotoMotoristaAcompanhar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/txtMotoristaAcompanhar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#686D75"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="João Silva · ABC-1234" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Centralizar na van -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCentralizarVanAcompanhar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Centralizar na van"
        android:src="@drawable/ic_van"
        app:backgroundTint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/btnCentralizarPassageiroAcompanhar"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="22dp"
        app:tint="@color/color_primary" />

    <!-- Centralizar no passageiro -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCentralizarPassageiroAcompanhar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Centralizar no passageiro"
        android:src="@drawable/ic_pin_central"
        app:backgroundTint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/cardStatusAcompanhar"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="22dp" />

    <!-- Status real do aluno, no rodapé -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatusAcompanhar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fotoAlunoAcompanhar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeAlunoAcompanhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#101010"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Maria" />

                    <TextView
                        android:id="@+id/txtEnderecoAcompanhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#686D75"
                        android:textSize="12sp"
                        tools:text="Rua Exemplo, 123" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtStatusAlunoAcompanhar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_container_round_30"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Na van" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtStatusViagemAcompanhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#686D75"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Carregando viagem..." />

            <TextView
                android:id="@+id/txtEtaAcompanhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Chegada estimada: 07:42"
                tools:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
