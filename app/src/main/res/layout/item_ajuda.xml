<?xml version="1.0" encoding="utf-8"?>
<!-- Um cartão da Ajuda (guia ou "rever o tour"): ícone num quadrinho da cor
     do perfil, título, resumo e a seta. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgIconeAjuda"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icone_responsavel"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_ajuda"
            app:tint="@color/passageiro_destaque_forte" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloAjuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Como adicionar um passageiro" />

            <TextView
                android:id="@+id/txtResumoAjuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Cadastre seu filho e o local de embarque." />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_direita"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
