<?xml version="1.0" encoding="utf-8"?>
<!-- Mensagem enviada: bolha à direita (laranja no responsável, escura no
     motorista: MensagemAdapter.bolhaEnviada), horário no canto da bolha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="60dp"
    android:paddingEnd="14dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/bolhaMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bolha_enviada"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txtMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark"
            android:textSize="15sp"
            tools:text="Bom dia, Carlos! Ótimo, obrigado!" />

        <TextView
            android:id="@+id/txtHoraMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:alpha="0.85"
            android:textColor="@color/text_on_dark"
            android:textSize="11sp"
            tools:text="07:35" />
    </LinearLayout>
</LinearLayout>
