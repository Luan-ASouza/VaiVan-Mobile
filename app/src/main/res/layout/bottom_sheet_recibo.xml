<?xml version="1.0" encoding="utf-8"?>
<!-- Recibo de uma cobrança paga da assinatura (texto de AssinaturaUi.textoDoRecibo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_icone_motorista"
        android:backgroundTint="@color/status_success_fundo"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_aprovado"
        app:tint="@color/status_success" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Recibo de pagamento"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/txtRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tile_rota"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="13sp"
        tools:text="Nº do recibo: 1A2B3C4D\nDescrição: Plano Básico\nValor: R$ 49,90" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCompartilharRecibo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Compartilhar"
        android:textAllCaps="false"
        android:textColor="@color/text_on_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rota_destaque"
        app:cornerRadius="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFecharRecibo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Fechar"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />
</LinearLayout>
