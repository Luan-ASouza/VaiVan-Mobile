<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="12dp"
            android:src="@drawable/ic_arrowback"
            app:tint="#202124" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnAjuda"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Ajuda"
            android:textColor="#202124"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- PROGRESSO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#F6B12F"
            android:background="@android:drawable/progress_horizontal" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#F6B12F" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#F6B12F" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:background="#EEEEEE" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Enviar documentos"
                android:textColor="#101010"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Envie os documentos necessários para concluir seu cadastro como motorista."
                android:textColor="#858585"
                android:textSize="16sp" />

            <!-- LISTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="72dp"
                android:orientation="vertical">

                <!-- CNH -->
                <LinearLayout
                    android:id="@+id/itemCnh"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconeCnh"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_enviar_arquivo"
                        app:tint="@color/dark_gray"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CNH"
                            android:textColor="#101010"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStatusCnh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pendente"
                            android:visibility="gone"
                            android:textColor="#999999"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_chevron_direita"
                        app:tint="@color/dark_gray"/>

                </LinearLayout>

                <!-- CRLV -->
                <LinearLayout
                    android:id="@+id/itemComprovante"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconeComprovante"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_enviar_arquivo"
                        app:tint="@color/dark_gray"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Comprovante de Residência"
                            android:textColor="#101010"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStatusComprovante"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pendente"
                            android:visibility="gone"
                            android:textColor="#999999"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_chevron_direita"
                        app:tint="@color/dark_gray"/>

                </LinearLayout>

                <!-- FOTO -->
                <LinearLayout
                    android:id="@+id/itemFoto"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconeFoto"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_enviar_arquivo"
                        app:tint="@color/dark_gray"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Foto do motorista"
                            android:textColor="#101010"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStatusFoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pendente"
                            android:visibility="gone"
                            android:textColor="#999999"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_chevron_direita"
                        app:tint="@color/dark_gray"/>

                </LinearLayout>

            </LinearLayout>

            <!-- DICAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:text="Dicas"
                android:textColor="#929292"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Os documentos enviados serão armazenados com segurança. Mantenha suas informações atualizadas para facilitar a verificação."
                android:textColor="#929292"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressDocumentos"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#F6B12F"
        android:visibility="gone" />

</LinearLayout>