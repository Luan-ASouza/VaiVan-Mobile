<?xml version="1.0" encoding="utf-8"?>
<!-- Histórico de mensalidades de um passageiro (motorista). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottomsheet_white"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="80dp"
        android:layout_height="7dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_white_rounded"
        android:backgroundTint="#dbdce0" />

    <TextView
        android:id="@+id/txtTituloHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_gray"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Maria Souza" />

    <TextView
        android:id="@+id/txtSubtituloHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/medium_gray"
        android:textSize="13sp"
        tools:text="R$ 400,00 / mês · vence dia 10" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/containerHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReajustarContrato"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Alterar valor ou vencimento"
        android:textAllCaps="false"
        android:textColor="@color/dark_gray"
        app:strokeColor="@color/dark_gray" />
</LinearLayout>
