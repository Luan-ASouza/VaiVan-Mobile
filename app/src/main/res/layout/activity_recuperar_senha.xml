<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperação de senha: mesmo visual do cadastro (diagonal amarela, marca
     d'água da van, logo e cartão branco). Dois estados no mesmo cartão:
     grupoFormulario (e-mail + enviar) e grupoEnviado (aviso + voltar). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_container"
    android:clipChildren="true">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaDiagonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.49" />

    <View
        android:layout_width="3000dp"
        android:layout_height="3000dp"
        android:background="@color/color_primary"
        android:rotation="-24"
        android:transformPivotX="0dp"
        android:transformPivotY="1500dp"
        app:layout_constraintStart_toStartOf="@id/guiaDiagonal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:layout_width="300dp"
        android:layout_height="248dp"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-36dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:rotation="-14"
        android:src="@drawable/ic_vaivan"
        app:tint="@color/cadastro_marca_dagua"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Espaço da barra de status -->
    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="290dp"
        android:layout_height="80dp"
        android:layout_marginTop="44dp"
        android:contentDescription="VaiVan, vai contigo!"
        android:src="@drawable/logo_vaivan"
        app:layout_constraintTop_toBottomOf="@id/topGap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollRecuperarSenha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="220dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_cadastro_card"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="26dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrowback"
                app:tint="@color/text_primary" />

            <!-- ESTADO 1: FORMULÁRIO -->
            <LinearLayout
                android:id="@+id/grupoFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Recuperar senha"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="26dp"
                    android:gravity="center"
                    android:text="Digite o e-mail da sua conta. Vamos enviar um link para você criar uma nova senha."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Email"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_cadastro_input"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSend"
                        android:inputType="textEmailAddress"
                        android:minHeight="50dp"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/status_danger"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/btn_gray_filled"
                    android:text="Enviar"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_dark"
                    android:textSize="18sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- ESTADO 2: E-MAIL ENVIADO -->
            <LinearLayout
                android:id="@+id/grupoEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_check"
                    app:tint="@color/status_success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="E-mail enviado!"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- A tela troca na hora do toque; isto fica visível só até o
                     Firebase confirmar o envio (some no sucesso, e no erro a
                     tela volta pro formulário). -->
                <LinearLayout
                    android:id="@+id/grupoStatusEnvio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/text_secondary"
                        app:indicatorSize="16dp"
                        app:trackThickness="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Enviando…"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescricaoEnviado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoltarLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/btn_gray_filled"
                    android:text="Voltar para o login"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_dark"
                    android:textSize="18sp"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/txtReenviar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="6dp"
                    android:text="Não recebeu? Enviar novamente"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Espaço da barra de navegação -->
    <View
        android:id="@+id/bottomGap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
