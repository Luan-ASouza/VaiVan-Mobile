<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical">

    <!-- CABEÇALHO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Onda decorativa -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:scaleX="-1"
            android:src="@drawable/bg_onda_passageiro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transportes"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acompanhe as viagens dos seus filhos"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <!-- ABAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Viagens -->
                <TextView
                    android:id="@+id/abaViagensRotas"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aba_selecionada"
                    android:gravity="center"
                    android:textColor="@color/text_on_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Viagens (2)" />

                <!-- Pedidos -->
                <TextView
                    android:id="@+id/abaPedidosRotas"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aba"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Pedidos (1)" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ÁREA ROLÁVEL -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshListaRotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/containerRotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="90dp">

                <!-- LISTA DE TRANSPORTES -->
                <LinearLayout
                    android:id="@+id/containerListaRotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <!-- ESTADO VAZIO -->
                <TextView
                    android:id="@+id/txtVazioRotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Nenhum transporte ainda."
                    tools:visibility="visible" />

            </LinearLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
