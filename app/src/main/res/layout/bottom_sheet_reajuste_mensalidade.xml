<?xml version="1.0" encoding="utf-8"?>
<!-- Motorista define/altera o valor mensal e o dia de vencimento de um aluno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/txtTituloReajuste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Mensalidade de Maria" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="A mudança vale a partir da próxima mensalidade gerada. As que já foram geradas não mudam."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- VALOR -->
    <TextView
        style="@style/RotuloEdicaoPerfil"
        android:layout_marginTop="20dp"
        android:text="Valor mensal"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/caixaValorReajuste"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/edtValorReajuste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="0,00"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- VENCIMENTO -->
    <TextView
        style="@style/RotuloEdicaoPerfil"
        android:text="Dia do vencimento"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/caixaDiaReajuste"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todo dia"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/edtDiaReajuste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="1 a 28"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtErroReajuste"
        style="@style/ErroEdicaoPerfil"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarReajuste"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Salvar"
        android:textAllCaps="false"
        android:textColor="@color/text_on_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rota_destaque"
        app:cornerRadius="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarReajuste"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />
</LinearLayout>
