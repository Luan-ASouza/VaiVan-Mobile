<?xml version="1.0" encoding="utf-8"?><!-- Menu lateral: fundo escuro, itens claros e o item ativo como uma "aba"
     clara encostada no conteúdo (ver bg_drawer_item / style DrawerItem). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_drawer_head"
        android:paddingStart="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="50dp">

        <!-- Cabeçalho do perfil -->
        <LinearLayout
            android:id="@+id/drawerPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_profile"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            android:clickable="true">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawerAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/dark_gray"
                app:strokeWidth="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/drawerTxtNomeDoUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/drawerNota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="5.0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/imgSetaCampo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_direita"
                app:tint="@color/text_tertiary" />

        </LinearLayout>

    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="2"
        android:background="@drawable/bg_drawer_body"
        android:paddingBottom="20dp">


        <!-- Menu -->
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/space">

            <LinearLayout
                android:id="@+id/btnDrawerPerfil"
                style="@style/DrawerItem">

                <ImageView
                    style="@style/DrawerItemIcone"
                    android:src="@drawable/ic_perfil" />

                <TextView
                    style="@style/DrawerItemTexto"
                    android:text="Meu perfil" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDrawerPassageiros"
                style="@style/DrawerItem">

                <ImageView
                    style="@style/DrawerItemIcone"
                    android:src="@drawable/ic_passageiros" />

                <TextView
                    style="@style/DrawerItemTexto"
                    android:text="Passageiros" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDrawerLocais"
                style="@style/DrawerItem">

                <ImageView
                    style="@style/DrawerItemIcone"
                    android:src="@drawable/ic_local" />

                <TextView
                    style="@style/DrawerItemTexto"
                    android:text="Locais salvos" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDrawerTransportes"
                style="@style/DrawerItem">

                <ImageView
                    style="@style/DrawerItemIcone"
                    android:src="@drawable/ic_van" />

                <TextView
                    style="@style/DrawerItemTexto"
                    android:text="Meus transportes" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDrawerMensalidades"
                style="@style/DrawerItem">

                <ImageView
                    style="@style/DrawerItemIcone"
                    android:src="@drawable/ic_pagamentos" />

                <TextView
                    style="@style/DrawerItemTexto"
                    android:text="Mensalidades" />

            </LinearLayout>

        </LinearLayout>


        <!-- Espaço -->
        <Space
            android:id="@+id/space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="20dp"
            android:background="@color/divider_drawer"
            app:layout_constraintBottom_toTopOf="@+id/btnDrawerDesconectar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- Desconectar -->
        <LinearLayout
            android:id="@+id/btnDrawerDesconectar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_button_red"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_desconectar"
                app:tint="@color/text_on_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Desconectar"
                android:textColor="@color/text_on_dark"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
