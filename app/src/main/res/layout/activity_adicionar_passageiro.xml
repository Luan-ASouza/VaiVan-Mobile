<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro de passageiro, no mesmo visual das telas de edição do perfil
     (barra só com voltar, título grande, campos arredondados, rodapé Salvar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/conteudoEdicaoPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/barra_topo_edicao_perfil" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Novo passageiro"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cadastre seu filho(a) para buscar uma van e acompanhar as viagens."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- FOTO -->
                <FrameLayout
                    android:id="@+id/btnFotoNovoPassageiro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:contentDescription="Escolher foto do passageiro"
                    android:focusable="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgFotoNovoPassageiro"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_01"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/txtSeloFotoNovoPassageiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:text="Adicionar foto"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- NOME -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:layout_marginTop="24dp"
                    android:text="Nome completo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNomeNovoPassageiro"
                    style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNomeNovoPassageiro"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Nome do seu filho(a)"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroNomeNovoPassageiro"
                    style="@style/ErroEdicaoPerfil" />

                <!-- NASCIMENTO -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Data de nascimento" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNascimentoNovoPassageiro"
                    style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNascimentoNovoPassageiro"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="DD/MM/AAAA"
                        android:inputType="number"
                        android:maxLength="10" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroNascimentoNovoPassageiro"
                    style="@style/ErroEdicaoPerfil" />

                <!-- NECESSIDADES -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Possui alguma necessidade especial?" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNecessidadeSim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="Sim"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="30dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNecessidadeNao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="Não"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="30dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerDescricaoNecessidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/RotuloEdicaoPerfil"
                        android:text="Qual? (opcional)" />

                    <com.google.android.material.textfield.TextInputLayout style="@style/CaixaEdicaoPerfil">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDescricaoNecessidade"
                            style="@style/TextoEdicaoPerfil"
                            android:gravity="top|start"
                            android:hint="Ex.: usa cadeira de rodas, autismo, alergia..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- OBSERVAÇÕES -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Observações (opcional)" />

                <com.google.android.material.textfield.TextInputLayout style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtObservacoesNovoPassageiro"
                        style="@style/TextoEdicaoPerfil"
                        android:gravity="top|start"
                        android:hint="Ex.: desce no portão lateral"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroGeralNovoPassageiro"
                    style="@style/ErroEdicaoPerfil"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/rodape_salvar_edicao_perfil" />
    </LinearLayout>

</LinearLayout>
