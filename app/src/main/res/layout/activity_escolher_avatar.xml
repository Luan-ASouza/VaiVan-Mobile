<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <include layout="@layout/barra_topo_edicao_perfil" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="Escolha um avatar"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- PRÉVIA -->
    <ImageView
        android:id="@+id/imgPreviaAvatar"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="Prévia do avatar" />

    <!-- CORES (bolinhas montadas no código, uma por AvatarCatalogo.CORES) -->
    <TextView
        style="@style/RotuloEdicaoPerfil"
        android:layout_marginStart="24dp"
        android:text="Cor" />

    <LinearLayout
        android:id="@+id/containerCoresAvatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp" />

    <!-- AVATARES -->
    <TextView
        style="@style/RotuloEdicaoPerfil"
        android:layout_marginStart="24dp"
        android:text="Avatar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAvatares"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/rodape_salvar_edicao_perfil" />

    <View
        android:id="@+id/bottomGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

</LinearLayout>
