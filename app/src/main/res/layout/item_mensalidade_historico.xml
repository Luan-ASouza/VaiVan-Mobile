<?xml version="1.0" encoding="utf-8"?>
<!-- Uma mensalidade no histórico: mês + selo de status, detalhe e a ação do mês
     (registrar/desfazer recebimento ou pagar), na cor do perfil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tile_rota"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMesHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Novembro/2026" />

        <TextView
            android:id="@+id/txtStatusHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pilula_branca"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Paga" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtDetalheHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="R$ 400,00 · Pago em 08/11/2026 · Dinheiro" />

    <TextView
        android:id="@+id/btnAcaoHistorico"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_botao_escuro"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_on_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Registrar recebimento"
        tools:visibility="visible" />
</LinearLayout>
