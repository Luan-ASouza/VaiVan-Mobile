<?xml version="1.0" encoding="utf-8"?>
<!-- Pagamentos do motorista: resumo do mês + um cartão por aluno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPagamentos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical">

    <!-- CABEÇALHO (fixo, fora da rolagem) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Onda decorativa -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:scaleX="-1"
            android:src="@drawable/bg_onda_motorista" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/topGap"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <ImageButton
                    android:id="@+id/btnVoltarPagamentos"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="-10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrowback"
                    app:tint="@color/text_primary"
                    tools:ignore="HardcodedText" />

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pagamentos"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acompanhe as mensalidades dos seus alunos"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ÁREA ROLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <ProgressBar
                android:id="@+id/progressPagamentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/dark_gray" />

            <!-- CONTEÚDO (somente com assinatura em dia) -->
            <LinearLayout
                android:id="@+id/conteudoPagamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- RESUMO DO MÊS (cartão escuro de destaque) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_hero_card"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtLabelRecebido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        tools:text="Recebido em novembro" />

                    <TextView
                        android:id="@+id/txtRecebidoMes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/orange"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        tools:text="R$ 3.200,00" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A receber no mês"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtAReceberMes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@android:color/white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="R$ 800,00" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Em atraso"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtEmAtraso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#FF8A80"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="R$ 400,00" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quantos alunos em cada situação -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtQtdEmDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_hero"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="8 em dia" />

                    <TextView
                        android:id="@+id/txtQtdAtrasados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_hero"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="1 atrasado" />

                    <TextView
                        android:id="@+id/txtQtdInadimplentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_hero"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="1 inadimplente" />

                    </LinearLayout>
                </LinearLayout>

                <!-- FILTRO -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoFiltroPagamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_container_round_30"
                    android:elevation="2dp"
                    android:padding="4dp"
                    app:checkedButton="@id/btnFiltroTodos"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroTodos"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background"
                    app:cornerRadius="21dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroEmDia"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Em dia"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background"
                    app:cornerRadius="21dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroPendentes"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Pendentes"
                    android:textAllCaps="false"
                    android:textColor="@color/button_toggle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_toggle_background"
                    app:cornerRadius="21dp"
                    app:strokeWidth="0dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/TituloSecaoRota"
                    android:text="Alunos"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:id="@+id/containerContratos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <!-- ESTADO VAZIO -->
                <TextView
                    android:id="@+id/txtVazioPagamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Nenhum aluno por aqui." />
            </LinearLayout>

            <!-- BLOQUEIO (assinatura sem condição de operar) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/blocoBloqueado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/background_container"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_icone_motorista"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_cadeado"
                        app:tint="@color/rota_destaque" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Área indisponível"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="A gestão de pagamentos fica disponível com a assinatura em dia. Regularize sua assinatura para voltar a acessar."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />

                    <Button
                        android:id="@+id/btnIrParaAssinatura"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_botao_escuro"
                        android:text="Ver minha assinatura"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/bottomGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

</LinearLayout>
