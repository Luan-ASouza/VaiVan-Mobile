<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/conteudoEdicaoPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/barra_topo_edicao_perfil" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereço"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Digite o CEP para preencher o restante automaticamente."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- CEP -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:layout_marginTop="24dp"
                    android:text="CEP" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCepEndereco"
                    style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCepEndereco"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="00000-000"
                        android:inputType="number"
                        android:maxLength="9" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroCepEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/status_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- ESTADO / CIDADE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RotuloEdicaoPerfil"
                            android:text="Estado" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEstadoEndereco"
                            style="@style/CaixaEdicaoPerfil">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtEstadoEndereco"
                                style="@style/TextoEdicaoPerfil"
                                android:hint="UF"
                                android:inputType="textCapCharacters"
                                android:maxLength="2" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RotuloEdicaoPerfil"
                            android:text="Cidade" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutCidadeEndereco"
                            style="@style/CaixaEdicaoPerfil">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtCidadeEndereco"
                                style="@style/TextoEdicaoPerfil"
                                android:hint="Cidade"
                                android:inputType="textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- BAIRRO -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Bairro" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBairroEndereco"
                    style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtBairroEndereco"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Bairro"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- RUA -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Rua" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRuaEndereco"
                    style="@style/CaixaEdicaoPerfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRuaEndereco"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Rua"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- NÚMERO / COMPLEMENTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RotuloEdicaoPerfil"
                            android:text="Número" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutNumeroEndereco"
                            style="@style/CaixaEdicaoPerfil">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtNumeroEndereco"
                                style="@style/TextoEdicaoPerfil"
                                android:hint="Nº"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RotuloEdicaoPerfil"
                            android:text="Complemento" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CaixaEdicaoPerfil">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtComplementoEndereco"
                                style="@style/TextoEdicaoPerfil"
                                android:hint="Opcional"
                                android:imeOptions="actionDone"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtErroEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="12dp"
                    android:text="*Preencha os campos destacados."
                    android:textColor="@color/status_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/rodape_salvar_edicao_perfil" />
    </LinearLayout>

</LinearLayout>
