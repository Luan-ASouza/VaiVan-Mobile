<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/fotoProgressoPassageiro"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/filho1"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="@color/dark_gray"
        app:strokeWidth="3dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nomeProgressoPassageiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_secondary"
            android:text="Nome do Passageiro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/enderecoProgressoPassageiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Endereço do passageiro"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#686D75"
            android:textSize="16sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/statusProgressoPassageiro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
