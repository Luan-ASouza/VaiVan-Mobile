<?xml version="1.0" encoding="utf-8"?>
<!-- Motorista registra uma mensalidade recebida fora do app: mês, valor e a
     forma de pagamento (opções em pílulas; a marcada fica escura). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_icone_motorista"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_lucro"
        app:tint="@color/rota_destaque" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Registrar recebimento"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/txtDescricaoRecebimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Novembro/2026 · Maria Souza" />

    <TextView
        android:id="@+id/txtValorRecebimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        tools:text="R$ 400,00" />

    <TextView
        style="@style/TituloSecaoRota"
        android:layout_marginStart="2dp"
        android:layout_marginTop="16dp"
        android:text="Como você recebeu?"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/opcaoFormaPix"
            style="@style/OpcaoFormaPagamento"
            android:layout_marginEnd="4dp"
            android:text="PIX"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/opcaoFormaDinheiro"
            style="@style/OpcaoFormaPagamento"
            android:layout_marginStart="4dp"
            android:text="Dinheiro"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/opcaoFormaTransferencia"
            style="@style/OpcaoFormaPagamento"
            android:layout_marginEnd="4dp"
            android:text="Transferência"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/opcaoFormaOutro"
            style="@style/OpcaoFormaPagamento"
            android:layout_marginStart="4dp"
            android:text="Outro"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarRecebimento"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Confirmar recebimento"
        android:textAllCaps="false"
        android:textColor="@color/text_on_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rota_destaque"
        app:cornerRadius="16dp"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarRecebimento"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />
</LinearLayout>
