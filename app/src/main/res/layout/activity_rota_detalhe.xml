<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe da rota (motorista): cabeçalho fixo com as ações (iniciar
     viagem / ver trajeto) e as abas Informações, Percurso e Alunos. Só o
     conteúdo da aba rola. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical">

    <!-- CABEÇALHO (fixo, fora da rolagem) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Onda decorativa -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:scaleX="-1"
            android:src="@drawable/bg_onda_motorista" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/topGap"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="14dp">

                <ImageButton
                    android:id="@+id/btnVoltar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="-10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrowback"
                    app:tint="@color/text_primary"
                    tools:ignore="HardcodedText" />

                <!-- Título -->
                <TextView
                    android:id="@+id/txtNomeRotaDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Escola Municipal - Manhã" />

                <!-- Subtítulo + selo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtResumoRotaDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Manhã • Ida e volta • Seg a Sex" />

                    <TextView
                        android:id="@+id/txtStatusDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pilula_branca"
                        android:backgroundTint="@color/transporte_andamento_fundo"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/transporte_andamento_texto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Ativa" />
                </LinearLayout>

                <!-- Ações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarViagemDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Iniciar viagem"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/rota_destaque"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_van"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/text_on_dark"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrajetoDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver trajeto"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/background_container"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_rotas"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/text_primary"
                        app:strokeColor="@color/rota_vagas_fundo"
                        app:strokeWidth="1dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- ABAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/abaInformacoesDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_aba_escura_selecionada"
                        android:gravity="center"
                        android:text="Informações"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/abaPercursoDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_aba"
                        android:gravity="center"
                        android:text="Percurso"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:id="@+id/abaAlunosDetalhe"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_aba"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtAbaAlunosDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alunos"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <!-- Pedidos aguardando resposta -->
                        <TextView
                            android:id="@+id/txtBadgeAlunosDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_contador"
                            android:gravity="center"
                            android:minWidth="20dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="2"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ÁREA ROLÁVEL (conteúdo da aba aberta) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshRotaDetalhe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollRotaDetalhe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="32dp">

                <!-- ===== ABA INFORMAÇÕES ===== -->
                <LinearLayout
                    android:id="@+id/conteudoInformacoesDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Vagas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtVagasLivresDetalhe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                tools:text="3" />

                            <TextView
                                android:id="@+id/txtVagasLegendaDetalhe"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="6dp"
                                android:layout_weight="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                tools:text="vagas livres" />

                            <TextView
                                android:id="@+id/txtVagasOcupadasDetalhe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="12 de 15 ocupadas" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressVagasDetalhe"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progressDrawable="@drawable/progress_vagas_escuro"
                            tools:progress="80" />
                    </LinearLayout>

                    <!-- Rota -->
                    <TextView
                        style="@style/TituloSecaoRota"
                        android:text="Rota"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <include
                            android:id="@+id/campoNomeRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoSentidoRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoTurnoRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoDiasRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoCapacidadeRota"
                            layout="@layout/item_perfil_campo" />
                    </LinearLayout>

                    <!-- Locais -->
                    <TextView
                        style="@style/TituloSecaoRota"
                        android:text="Locais"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <include
                            android:id="@+id/campoEscolaRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoPontoRota"
                            layout="@layout/item_perfil_campo" />

                        <View style="@style/DivisorCampoPerfil" />

                        <include
                            android:id="@+id/campoBairrosRota"
                            layout="@layout/item_perfil_campo" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnExcluirRota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Excluir rota"
                        android:textColor="@color/status_danger"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- ===== ABA PERCURSO ===== -->
                <LinearLayout
                    android:id="@+id/conteudoPercursoDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Distância | tempo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_rounded"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/txtDistanciaDetalhe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="12,4 km" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distância"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_rounded"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/txtDuracaoDetalhe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="35 min" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tempo estimado"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTituloParadasDetalhe"
                        style="@style/TituloSecaoRota"
                        android:text="Ordem das paradas"
                        tools:ignore="HardcodedText" />

                    <!-- Linha do tempo: partida → alunos → escola (em código) -->
                    <LinearLayout
                        android:id="@+id/containerPercursoDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp" />

                    <TextView
                        android:id="@+id/txtNotaVoltaDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="6dp"
                        android:text="Na volta, a van sai da escola e a ordem das casas é recalculada ao iniciar a viagem."
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <!-- Refaz o trajeto com os alunos atuais (também acontece
                         sozinho quando um aluno sai da rota) -->
                    <TextView
                        android:id="@+id/btnRecalcularTrajetoDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Recalcular trajeto"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- ===== ABA ALUNOS ===== -->
                <LinearLayout
                    android:id="@+id/conteudoAlunosDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Solicitações pendentes (some quando não há) -->
                    <LinearLayout
                        android:id="@+id/containerSecaoSolicitacoesDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TituloSecaoRota"
                            android:layout_marginTop="0dp"
                            android:text="Pedidos de vaga"
                            tools:ignore="HardcodedText" />

                        <LinearLayout
                            android:id="@+id/containerSolicitacoesDetalhe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Avisos de ausência (some quando não há) -->
                    <LinearLayout
                        android:id="@+id/containerSecaoAvisosAusenciaDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TituloSecaoRota"
                            android:text="Avisos de falta"
                            tools:ignore="HardcodedText" />

                        <LinearLayout
                            android:id="@+id/containerAvisosAusenciaDetalhe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Confirmados, aguardando pagamento e recusados (em código) -->
                    <LinearLayout
                        android:id="@+id/containerAlunosDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View
        android:id="@+id/bottomGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />
</LinearLayout>
