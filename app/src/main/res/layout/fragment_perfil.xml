<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil (motorista e responsável): lista de campos agrupados em cards;
     cada linha abre a tela de edição daquele campo (ui/comum/perfil). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="90dp">

        <!-- CABEÇALHO: FOTO + NOME + NOTA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnFotoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Alterar foto de perfil"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgUsuarioAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_status_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="Editar"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNomeUsuarioCompleto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_bairro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star"
                    app:tint="@color/orange" />

                <TextView
                    android:id="@+id/txtNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5,0"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- DADOS PESSOAIS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/campoNome"
                layout="@layout/item_perfil_campo" />

            <View style="@style/DivisorCampoPerfil" />

            <include
                android:id="@+id/campoSobrenome"
                layout="@layout/item_perfil_campo" />

            <View style="@style/DivisorCampoPerfil" />

            <include
                android:id="@+id/campoNascimento"
                layout="@layout/item_perfil_campo" />

            <View style="@style/DivisorCampoPerfil" />

            <include
                android:id="@+id/campoCpf"
                layout="@layout/item_perfil_campo" />
        </LinearLayout>

        <!-- CONTATO E ENDEREÇO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/campoTelefone"
                layout="@layout/item_perfil_campo" />

            <View style="@style/DivisorCampoPerfil" />

            <include
                android:id="@+id/campoEmail"
                layout="@layout/item_perfil_campo" />

            <View style="@style/DivisorCampoPerfil" />

            <include
                android:id="@+id/campoEndereco"
                layout="@layout/item_perfil_campo" />
        </LinearLayout>

        <!-- SEGURANÇA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/campoSenha"
                layout="@layout/item_perfil_campo" />
        </LinearLayout>

        <!-- CONTA -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDesconectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_red"
            android:minHeight="52dp"
            android:text="Desconectar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/btnExcluirConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="Excluir minha conta"
            android:textColor="@color/status_danger"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
