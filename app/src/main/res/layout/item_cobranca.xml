<?xml version="1.0" encoding="utf-8"?>
<!-- Uma cobrança da assinatura: descrição + selo de status, detalhe e as ações
     (pagar / ver recibo). -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDescricaoCobranca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Plano Básico · novembro" />

            <TextView
                android:id="@+id/txtStatusCobranca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pilula_branca"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Pago" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDetalheCobranca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Pago em 10/11/2026 · R$ 49,90" />

        <Button
            android:id="@+id/btnPagarCobranca"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_escuro"
            android:text="Pagar com PIX"
            android:textAllCaps="false"
            android:textColor="@color/text_on_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnReciboCobranca"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_contorno_escuro"
            android:text="Ver recibo"
            android:textAllCaps="false"
            android:textColor="@color/rota_destaque"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
