<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_container">

    <!-- MAPA em tela cheia, por trás da status bar (mesmo layout do acompanhamento) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaRota"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Degradê no topo pra os ícones da status bar não brigarem com o mapa -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scrim_topo_mapa"
        app:layout_constraintBottom_toBottomOf="@id/topGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Voltar"
        android:src="@drawable/ic_arrowback"
        app:backgroundTint="@color/background_container"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabCustomSize="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGap"
        app:maxImageSize="18dp"
        app:tint="@color/text_primary" />

    <!-- PAINEL INFERIOR -->
    <LinearLayout
        android:id="@+id/painelRota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_painel_mapa"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/txtTituloRota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:maxLines="2"
            android:text="Trajeto da rota"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/txtResumoRota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Carregando trajeto..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- TRAJETO: partida → escola -->
        <LinearLayout
            android:id="@+id/secaoTrajetoRota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secao_sheet"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="3dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_ponto_rota_primario" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="4dp"
                    android:layout_weight="1"
                    android:background="@color/light_graysh" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_ponto_rota_escuro" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partida"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtPartidaRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Rua Exemplo, 123" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Escola"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtDestinoRota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Colégio Sagrado" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
