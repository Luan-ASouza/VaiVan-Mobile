<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/topGap"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/conteudoEdicaoPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/barra_topo_edicao_perfil" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alterar senha"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Confirme a sua senha atual e escolha uma nova, com 8 ou mais caracteres, pelo menos um número e um símbolo."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- SENHA ATUAL -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:layout_marginTop="24dp"
                    android:text="Senha atual" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSenhaAtual"
                    style="@style/CaixaEdicaoPerfil"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSenhaAtual"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Sua senha atual"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroSenhaAtual"
                    style="@style/ErroEdicaoPerfil" />

                <!-- NOVA SENHA -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Nova senha" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNovaSenha"
                    style="@style/CaixaEdicaoPerfil"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNovaSenha"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Nova senha"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroNovaSenha"
                    style="@style/ErroEdicaoPerfil" />

                <!-- CONFIRMAÇÃO -->
                <TextView
                    style="@style/RotuloEdicaoPerfil"
                    android:text="Confirmar nova senha" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutConfirmarSenha"
                    style="@style/CaixaEdicaoPerfil"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtConfirmarSenha"
                        style="@style/TextoEdicaoPerfil"
                        android:hint="Repita a nova senha"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtErroConfirmarSenha"
                    style="@style/ErroEdicaoPerfil" />

                <TextView
                    android:id="@+id/txtErroGeralSenha"
                    style="@style/ErroEdicaoPerfil"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/rodape_salvar_edicao_perfil" />
    </LinearLayout>

</LinearLayout>
