<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="20dp"
    app:cardElevation="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha principal: toque para expandir/recolher os detalhes -->
        <LinearLayout
            android:id="@+id/linhaPrincipalItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoPassageiroItem"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_01"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/dark_gray"
                app:strokeWidth="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomePassageiroItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIdadePassageiroItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#707070" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgEditarPassageiroItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar passageiro"
                android:padding="4dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/dark_gray" />

            <ImageView
                android:id="@+id/imgExcluirPassageiroItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir passageiro"
                android:padding="4dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_danger" />

            <ImageView
                android:id="@+id/imgChevronItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Ver mais detalhes"
                android:padding="8dp"
                android:src="@drawable/icon_dropdown"
                app:tint="@color/light_gray" />
        </LinearLayout>

        <!-- Detalhes (escondido por padrão, abre ao tocar na linha acima) -->
        <LinearLayout
            android:id="@+id/containerDetalhesItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="62dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNecessidadePassageiroItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/dark_gray"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtObservacoesPassageiroItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#707070"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBuscarRotaItem"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_gray_filled"
            android:text="Buscar rota para este aluno"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

        <!-- Pedido pendente ou rota atual: aparece NO LUGAR do "Buscar rota".
             Um filho só pode ter um pedido/rota por vez. -->
        <LinearLayout
            android:id="@+id/containerRotaAtualItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_rota_filho"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/txtStatusRotaItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Aguardando resposta do motorista" />

            <TextView
                android:id="@+id/txtDetalheRotaItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/gray"
                android:textSize="13sp"
                tools:text="La Salle - Manhã\nR$ 189,00 por mês" />

            <TextView
                android:id="@+id/btnCancelarRotaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp"
                android:textColor="@color/red"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Cancelar pedido" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>