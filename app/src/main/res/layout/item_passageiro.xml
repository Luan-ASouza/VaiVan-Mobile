<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="20dp"
    app:cardElevation="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha principal: toque para expandir/recolher os detalhes -->
        <LinearLayout
            android:id="@+id/linhaPrincipalItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoPassageiroItem"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_01"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/dark_gray"
                app:strokeWidth="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomePassageiroItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIdadePassageiroItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#707070" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgEditarPassageiroItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar passageiro"
                android:padding="4dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/dark_gray" />

            <ImageView
                android:id="@+id/imgExcluirPassageiroItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir passageiro"
                android:padding="4dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_danger" />

            <ImageView
                android:id="@+id/imgChevronItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Ver mais detalhes"
                android:padding="8dp"
                android:src="@drawable/icon_dropdown"
                app:tint="@color/light_gray" />
        </LinearLayout>

        <!-- Detalhes (escondido por padrão, abre ao tocar na linha acima) -->
        <LinearLayout
            android:id="@+id/containerDetalhesItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="62dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNecessidadePassageiroItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/dark_gray"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtObservacoesPassageiroItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#707070"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBuscarRotaItem"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_gray_filled"
            android:text="Buscar rota para este aluno"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

        <!-- ROTA ATUAL OU PEDIDO: aparece NO LUGAR do "Buscar rota".
             Um filho só pode ter um pedido/rota por vez. -->
        <LinearLayout
            android:id="@+id/containerRotaAtualItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFEBE4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_inicial"
                    android:contentDescription="Van"
                    android:padding="9dp"
                    android:src="@drawable/ic_van"
                    app:tint="@color/dark_gray" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRotaAtualNomeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/dark_gray"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="La Salle - Manhã" />

                    <TextView
                        android:id="@+id/txtRotaAtualInfoItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#707070"
                        android:textSize="13sp"
                        tools:text="R$ 189,00 por mês" />
                </LinearLayout>

                <!-- "Aguardando" (laranja) ou "Ativa" (verde); cor vem do código -->
                <TextView
                    android:id="@+id/txtStatusRotaItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_situacao"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:backgroundTint="@color/orange"
                    tools:text="Aguardando" />
            </LinearLayout>

            <!-- Vaga reservada: pagar a 1ª mensalidade para ativar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPagarReservaItem"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Pagar e ativar a vaga"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/dark_gray"
                app:cornerRadius="21dp"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarRotaItem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:textColor="@color/dark_gray"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="21dp"
                app:strokeColor="@color/dark_gray"
                app:strokeWidth="1.5dp"
                tools:text="Cancelar pedido" />
        </LinearLayout>

        <!-- MENSALIDADE EM ATRASO: continua aparecendo mesmo depois de cancelar a rota -->
        <LinearLayout
            android:id="@+id/containerPendenciaItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_rota_filho"
            android:backgroundTint="#FDECEA"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensalidade em atraso"
                    android:textColor="@color/red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPendenciaValorItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dark_gray"
                    android:textSize="13sp"
                    tools:text="R$ 400,00 em aberto" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPagarPendenciaItem"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="Pagar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/dark_gray"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>