<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray">

    <!-- ÁREA ÚTIL DA NAVEGAÇÃO -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootNavegacaoViagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/topGap"
        app:layout_constraintBottom_toTopOf="@id/bottomGap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ================================================== -->
        <!-- MAPA DE NAVEGAÇÃO                                  -->
        <!-- ================================================== -->

        <com.google.android.libraries.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ================================================== -->
        <!-- BOTÕES FLUTUANTES — ancorados no topo do sheet     -->
        <!-- (acompanham o arraste), como no acompanhamento do  -->
        <!-- responsável                                        -->
        <!-- ================================================== -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnRecentralizarNavegacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginStart="16dp"
            android:translationY="-12dp"
            app:behavior_autoHide="false"
            android:contentDescription="Recentralizar mapa"
            android:src="@drawable/ic_mylocation"
            app:backgroundTint="@color/background_container"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:layout_anchor="@id/painelProgressoViagem"
            app:layout_anchorGravity="top|start"
            app:maxImageSize="22dp"
            app:tint="@color/text_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAlternarVozNavegacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginEnd="16dp"
            android:translationY="-12dp"
            app:behavior_autoHide="false"
            android:contentDescription="Ativar ou desativar a voz"
            android:src="@drawable/ic_som_ativado"
            app:backgroundTint="@color/background_container"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:layout_anchor="@id/painelProgressoViagem"
            app:layout_anchorGravity="top|end"
            app:maxImageSize="22dp"
            app:tint="@color/text_primary" />

        <!-- ================================================== -->
        <!-- BOTTOM SHEET: PROGRESSO DA VIAGEM                  -->
        <!-- Mesmo desenho do sheet do acompanhamento do        -->
        <!-- responsável (activity_acompanhar_viagem).          -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelProgressoViagem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_hideable="false"
            app:behavior_peekHeight="184dp"
            app:cardBackgroundColor="@color/background_container"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:layout_behavior="@string/bottom_sheet_behavior"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="10dp">

                    <!-- ALÇA DE ARRASTE -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_sheet_handle" />

                    <!-- ===== VISÍVEL RECOLHIDO ===== -->

                    <!-- STATUS (título) -->
                    <TextView
                        android:id="@+id/txtProximaParadaNavegacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_bold"
                        android:maxLines="2"
                        android:text="Carregando viagem..."
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        tools:ignore="HardcodedText" />

                    <!-- ENDEREÇO DA PRÓXIMA PARADA -->
                    <TextView
                        android:id="@+id/txtEnderecoProximaParadaNavegacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_semibold"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Rua das Flores, 120 - Centro"
                        tools:visibility="visible" />

                    <!-- ALUNO DA PRÓXIMA PARADA, com atalho do chat -->
                    <LinearLayout
                        android:id="@+id/linhaProximaParadaNavegacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/fotoProximaParadaNavegacao"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar_01"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtNomeProximaParadaNavegacao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/montserrat_semibold"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Lucas Santos" />

                            <TextView
                                android:id="@+id/txtTipoProximaParadaNavegacao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="Embarque · Casa" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnChatProximaParadaNavegacao"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_botao_redondo_claro"
                            android:contentDescription="Conversar com o responsável"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/text_primary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- ===== SÓ VISÍVEL EXPANDIDO ===== -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/background_screen" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Passageiros da viagem"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- LISTA DE PASSAGEIROS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProgressoViagem"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp" />

                <!-- AÇÕES DA VIAGEM -->
                <LinearLayout
                    android:id="@+id/containerBotoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@color/background_container"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/background_screen" />

                    <LinearLayout
                        android:id="@+id/barraBotoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPausarRetomarNavegacao"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Pausar"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/rota_tile"
                            app:cornerRadius="16dp"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFinalizarNavegacao"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Finalizar"
                            android:textAllCaps="false"
                            android:textColor="@color/text_on_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_danger"
                            app:cornerRadius="16dp"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReiniciarSimulacaoNavegacao"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Reiniciar simulação"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/color_primary"
                            app:cornerRadius="16dp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================== -->
        <!-- CARD DE CHEGADA À PARADA                           -->
        <!-- Título + timer e, para cada aluno da parada: foto, -->
        <!-- nome, chat e os botões de confirmação.             -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChegadaNavegacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/background_container"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CABEÇALHO: título + timer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTituloPainelParada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Chegando à parada"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        tools:ignore="HardcodedText" />

                    <!-- TIMER -->
                    <TextView
                        android:id="@+id/txtTimerCardChegada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_tile_rota"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="2:00" />
                </LinearLayout>

                <!-- Endereço não aparece no card (mantido só para o código) -->
                <TextView
                    android:id="@+id/txtEnderecoPainelParada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- PASSAGEIROS DA PARADA -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPassageirosPainelParada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />

                <!-- FINALIZAR PARADA FINAL -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalizarParadaFinal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Finalizar viagem"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/status_success"
                    app:cornerRadius="16dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ================================================== -->
    <!-- GAPS ABSOLUTOS                                     -->
    <!-- DEVEM FICAR ACIMA DE TODOS OS COMPONENTES          -->
    <!-- ================================================== -->

    <!-- TOP GAP -->

    <View
        android:id="@+id/topGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dark_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM GAP -->

    <View
        android:id="@+id/bottomGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
