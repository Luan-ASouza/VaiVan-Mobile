<?xml version="1.0" encoding="utf-8"?>
<!-- Uma conversa na lista: foto, nome + selo do papel (motorista/responsável),
     horário, aluno/rota da conversa e a última mensagem. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFotoConversa"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_perfil"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/chat_selo_motorista_fundo"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/txtNomeConversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/txtSeloConversa"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/imgFotoConversa"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Carlos Mendes" />

        <TextView
            android:id="@+id/txtSeloConversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_selo_motorista"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/chat_selo_motorista_texto"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtNomeConversa"
            app:layout_constraintEnd_toStartOf="@+id/txtHoraConversa"
            app:layout_constraintStart_toEndOf="@+id/txtNomeConversa"
            tools:text="Motorista"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtHoraConversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtNomeConversa"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="09:24" />

        <!-- De qual aluno e de qual rota é a conversa -->
        <TextView
            android:id="@+id/txtContextoConversa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chat_selo_motorista_texto"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txtNomeConversa"
            app:layout_constraintTop_toBottomOf="@+id/txtNomeConversa"
            tools:text="Aluno: Lucas · La Salle - Manhã"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtUltimaMensagemConversa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txtNomeConversa"
            app:layout_constraintTop_toBottomOf="@+id/txtContextoConversa"
            tools:text="Cheguei na primeira parada!" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
