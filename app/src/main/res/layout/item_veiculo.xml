<?xml version="1.0" encoding="utf-8"?>
<!-- Um veículo na lista do motorista. Card no estilo do card do passageiro
     (cantos de 28dp, elevação 8dp, onda escura), com as informações no arranjo
     de sempre: coluna à esquerda (modelo, placa, cor · ano, lugares e o selo
     de status embaixo). Lápis de editar no canto; excluir fica dentro da edição.

     Foto do modelo (trocada no código, ver VeiculosEscolares): não tem tamanho
     fixo. Ocupa toda a área livre — abaixo do nome do modelo e à direita da
     coluna de informações (barreira), com folga — e escala com fitEnd (maior
     tamanho que cabe, encostada embaixo à direita). Assim todos os modelos
     ficam o maior possível sem encostar no texto. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="184dp">

        <!-- Onda decorativa do canto superior direito (atrás da van) -->
        <ImageView
            android:id="@+id/imgOndaVeiculoItem"
            android:layout_width="190dp"
            android:layout_height="104dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:scaleX="-1"
            android:src="@drawable/bg_onda_motorista"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Editar (sobre a onda) -->
        <ImageView
            android:id="@+id/imgEditarVeiculoItem"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_rounded"
            android:contentDescription="Editar veículo"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_editar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary"
            tools:ignore="HardcodedText" />

        <!-- INFORMAÇÕES -->
        <TextView
            android:id="@+id/txtModeloVeiculoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/imgEditarVeiculoItem"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Mercedes Sprinter" />

        <TextView
            android:id="@+id/txtPlacaVeiculoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/txtModeloVeiculoItem"
            app:layout_constraintTop_toBottomOf="@+id/txtModeloVeiculoItem"
            tools:text="ABC1D23" />

        <LinearLayout
            android:id="@+id/linhaCorAnoVeiculoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@+id/txtModeloVeiculoItem"
            app:layout_constraintTop_toBottomOf="@+id/txtPlacaVeiculoItem">

            <TextView
                android:id="@+id/txtCorVeiculoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Branco" />

            <TextView
                android:id="@+id/txtAnoVeiculoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="2022" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCapacidadeVeiculoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/txtModeloVeiculoItem"
            app:layout_constraintTop_toBottomOf="@+id/linhaCorAnoVeiculoItem"
            tools:text="15 Lugares" />

        <TextView
            android:id="@+id/txtStatusVeiculoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_pendente"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="#E65100"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txtModeloVeiculoItem"
            tools:text="PENDENTE" />

        <!-- Borda direita das informações abaixo do nome (a foto começa depois dela) -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barreiraInformacoesVeiculoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="txtPlacaVeiculoItem,linhaCorAnoVeiculoItem,txtCapacidadeVeiculoItem,txtStatusVeiculoItem" />

        <!-- FOTO DO MODELO: toda a área livre, maior tamanho que cabe -->
        <ImageView
            android:id="@+id/imgFotoVeiculoItem"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Foto do modelo do veículo"
            android:scaleType="fitEnd"
            android:src="@drawable/foto_mercedes_benz_sprinter_branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/barreiraInformacoesVeiculoItem"
            app:layout_constraintTop_toBottomOf="@+id/txtModeloVeiculoItem"
            tools:ignore="HardcodedText" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
