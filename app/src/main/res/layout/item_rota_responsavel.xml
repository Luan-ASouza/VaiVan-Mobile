<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_beige_round_20"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ALUNO E NOME DA ROTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtInicialAlunoCard"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_avatar_inicial"
            android:gravity="center"
            android:text="A"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeAlunoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome do aluno"
                android:textColor="@color/dark_gray"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtNomeRotaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome da rota"
                android:textColor="@color/dark_gray"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- TIPO E TURNO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtTipoRotaCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTurnoRotaCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- PAINEL BRANCO: DIAS E PERCURSO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dias da semana"
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/containerDiasCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#EFEBE4" />

        <!-- bolinha - linha - bolinha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_dot_verde" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="4dp"
                    android:layout_weight="1"
                    android:background="#E0DBD2" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_dot_vermelho" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMBARQUE"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtEmbarqueCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dark_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DESEMBARQUE"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/txtDesembarqueCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dark_gray"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Só aparece na "Ida e volta" -->
        <TextView
            android:id="@+id/txtNotaVoltaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Na volta, o trajeto se inverte: da escola até o seu local."
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- MOTORISTA E VEÍCULO -->
    <TextView
        android:id="@+id/txtMotoristaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/dark_gray"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- PRÓXIMA COBRANÇA (apenas um aviso) -->
    <TextView
        android:id="@+id/txtProximaCobrancaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dark_gray"
        android:textSize="13sp" />

    <!-- ACOMPANHAR A VIAGEM DESTE FILHO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcompanharViagemCard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="Acompanhar viagem"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/dark_gray"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_mylocation"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        tools:ignore="HardcodedText" />

    <!-- ENVIAR MENSAGEM AO MOTORISTA DESTA VIAGEM -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarMensagemCard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Enviar mensagem"
        android:textAllCaps="false"
        android:textColor="@color/dark_gray"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="16dp"
        app:strokeColor="@color/dark_gray"
        app:strokeWidth="1dp"
        tools:ignore="HardcodedText" />

</LinearLayout>