<?xml version="1.0" encoding="utf-8"?>
<!-- Card de um transporte (um por filho): rota + aluno, selo da viagem de
     hoje, linha do tempo embarque → aluno → desembarque, endereços, dias,
     motorista e o bloco de aviso de falta. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/background_container"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ALUNO / ROTA / SELO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoAlunoCard"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_01"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/passageiro_destaque"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomeRotaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Escola Municipal - Manhã" />

                <TextView
                    android:id="@+id/txtNomeAlunoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Lucas • Manhã • Ida e volta" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSeloViagemCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pilula_branca"
                android:backgroundTint="@color/transporte_programada_fundo"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Programada"
                android:textColor="@color/transporte_programada_texto"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- LINHA DO TEMPO: embarque — aluno — desembarque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp">

            <View
                android:id="@+id/pontoInicioCard"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_ponto_timeline"
                android:backgroundTint="@color/transporte_linha_inativa" />

            <View
                android:id="@+id/linhaInicioCard"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/transporte_linha_inativa" />

            <ImageView
                android:id="@+id/pontoAlunoCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ponto_timeline"
                android:backgroundTint="@color/transporte_linha_inativa"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_van"
                app:tint="@color/text_on_dark" />

            <View
                android:id="@+id/linhaFimCard"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/transporte_linha_inativa" />

            <View
                android:id="@+id/pontoFimCard"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_ponto_timeline"
                android:backgroundTint="@color/transporte_linha_inativa" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtRotuloInicioCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Embarque" />

            <TextView
                android:id="@+id/txtRotuloAlunoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Na van" />

            <TextView
                android:id="@+id/txtRotuloFimCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Escola" />
        </LinearLayout>

        <!-- Status de hoje por direção (preenchido em código) -->
        <LinearLayout
            android:id="@+id/containerStatusViagemCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/chat_separador_data" />

        <!-- ENDEREÇOS + ACOMPANHAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_verde" />

                    <TextView
                        android:id="@+id/txtEmbarqueCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="R. Almerinda Ramos Santos, 92" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_vermelho" />

                    <TextView
                        android:id="@+id/txtDesembarqueCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="Rua Orlindo José Caselani, 192" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcompanharViagemCard"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Ver trajeto"
                android:textAllCaps="false"
                android:textColor="@color/transporte_programada_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/transporte_programada_fundo"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_rotas"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/transporte_programada_texto"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Dias da semana (um chip por dia, em código) -->
        <LinearLayout
            android:id="@+id/containerDiasCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <!-- Só aparece na "Ida e volta" -->
        <TextView
            android:id="@+id/txtNotaVoltaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Na volta, o trajeto se inverte: da escola até o seu local."
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/chat_separador_data" />

        <!-- MOTORISTA E VEÍCULO + MENSAGEM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFotoMotoristaCard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMotoristaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Carlos Mendes" />

                <TextView
                    android:id="@+id/txtVeiculoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Sprinter • ABC1D23" />
            </LinearLayout>

            <!-- ENVIAR MENSAGEM AO MOTORISTA DESTA VIAGEM -->
            <ImageButton
                android:id="@+id/btnEnviarMensagemCard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_botao_editar_passageiro"
                android:contentDescription="Enviar mensagem ao motorista"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chat"
                app:tint="@color/text_on_dark"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- AVISO DE AUSÊNCIA (preenchido em código — ver ListaRotasFragment.preencherRota) -->
        <LinearLayout
            android:id="@+id/containerAvisoAusenciaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
