<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================== -->
    <!-- 1. PALETA BASE (As cores puras)            -->
    <!-- ========================================== -->
    <color name="white">#FFFFFFFF</color>
    <color name="white_solitude">#F4F5F7</color>
    <color name="black">#000000</color>

    <color name="dark_gray">#1E1E1E</color>
    <color name="gray">#3A3A3A</color>
    <color name="medium_gray">#6B6B6B</color>
    <color name="light_gray">#AFAFAF</color>
    <color name="light_graysh">#D9D9D9</color>

    <color name="orange">#F6B12F</color>
    <color name="orange_dark">#C98A12</color>
    <color name="green">#2CA144</color>
    <color name="light_blue">#0170CC</color>
    <color name="red">#E53935</color>

    <color name="beige">#E4DBD4</color>
    <color name="beige_cream">#FAD897</color>
    <color name="background_card_base">#E5E0DA</color>


    <!-- ========================================== -->
    <!-- 2. CLASSES DE CORES (Uso Semântico)        -->
    <!-- ========================================== -->

    <!-- Classe: Backgrounds (Fundos) -->
    <color name="background_screen">@color/white_solitude</color>
    <color name="background_card">@color/background_card_base</color>
    <color name="background_container">@color/white</color>
    <!-- Menu lateral (drawer): fundo escuro; o item ativo usa background_screen
         para parecer uma "aba" ligada ao conteúdo. -->
    <color name="background_drawer">@color/dark_gray</color>
    <color name="divider_drawer">#E3E5E9</color>
    <!-- Telas de mídia em tela cheia (recorte de foto) -->
    <color name="background_midia">@color/black</color>
    <!-- Cabeçalho escuro com foto do veículo (cadastro de veículo): brilho no
         centro, borda mais escura. -->
    <color name="hero_glow">@color/gray</color>
    <color name="hero_base">@color/dark_gray</color>
    <color name="hero_botao_voltar">#33FFFFFF</color>

    <!-- Classe: Typography (Textos) -->
    <color name="text_primary">@color/dark_gray</color>
    <color name="text_secondary">@color/medium_gray</color>
    <color name="text_tertiary">@color/light_gray</color>
    <color name="text_on_dark">@color/white</color>
    <color name="text_on_dark_secondary">@color/light_gray</color>

    <!-- Classe: Brand & Actions (Identidade e Botões) -->
    <color name="color_primary">@color/orange</color>
    <color name="color_secondary">@color/white</color>
    <color name="accent_color">@color/dark_gray</color>

    <!-- Classe: Feedback (Alertas e Estados) -->
    <color name="status_success">@color/green</color>
    <color name="status_danger">@color/red</color>
    <color name="status_warning">@color/orange</color>

    <!-- Classe: Mapa (acompanhamento ao vivo). Rota = traço da marca com
         contorno mais escuro por baixo; pino escuro = escola/destino. -->
    <color name="mapa_rota">@color/color_primary</color>
    <color name="mapa_rota_contorno">@color/orange_dark</color>
    <color name="mapa_pino_escuro">@color/dark_gray</color>
    <color name="mapa_parada_outra">@color/light_gray</color>

    <!-- Classe: Borders & Dividers (Linhas e Contornos) -->
    <color name="border_light">@color/light_gray</color>
    <color name="divider">@color/light_gray</color>

    <!-- Classe: Avatares (drawable/avatar_*.xml)
         Os vetores pintam com ?attr/avatarCor (traço/roupa/cabelo) e
         ?attr/avatarCorClara (fundo). Cada par abaixo vira um
         ThemeOverlay.VaiVan.Avatar.* em themes.xml; o seletor de cor só troca
         o overlay. Tom claro = cor misturada 60% com branco. -->
    <color name="avatar_padrao">#333333</color>
    <color name="avatar_padrao_claro">#F2F2F2</color>

    <color name="avatar_rosa">#F09EA7</color>
    <color name="avatar_rosa_claro">#F9D8DC</color>

    <color name="avatar_pessego">#F6CA94</color>
    <color name="avatar_pessego_claro">#FBEAD4</color>

    <color name="avatar_amarelo">#FAFABE</color>
    <color name="avatar_amarelo_claro">#FDFDE5</color>

    <color name="avatar_verde">#C1EBC0</color>
    <color name="avatar_verde_claro">#E6F7E6</color>

    <color name="avatar_azul">#C7CAFF</color>
    <color name="avatar_azul_claro">#E9EAFF</color>

    <color name="avatar_lilas">#CDABEB</color>
    <color name="avatar_lilas_claro">#EBDDF7</color>

    <color name="avatar_magenta">#F6C2F3</color>
    <color name="avatar_magenta_claro">#FBE7FA</color>

</resources>
