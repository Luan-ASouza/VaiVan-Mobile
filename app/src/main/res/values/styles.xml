<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DiaSemanaButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>

        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>

        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>

        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/dark_gray</item>
        <item name="strokeWidth">1dp</item>

        <item name="backgroundTint">@color/white</item>
        <item name="rippleColor">#22000000</item>
    </style>

    <!-- Linha separadora entre os campos de um card do perfil (fragment_perfil). -->
    <style name="DivisorCampoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@color/background_screen</item>
    </style>

    <!-- Título de seção dentro das abas do detalhe da rota ("Rota", "Locais"...). -->
    <style name="TituloSecaoRota">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rótulo + campo das telas de edição do perfil com vários campos (endereço). -->
    <style name="RotuloEdicaoPerfil">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Mensagem de erro abaixo de um campo (começa escondida). -->
    <style name="ErroEdicaoPerfil">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/status_danger</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="CaixaEdicaoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input_white</item>
        <item name="boxBackgroundMode">none</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="TextoEdicaoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Opção selecionável em pílula dentro de um sheet (forma de pagamento,
         trajeto da falta). A selecionada é pintada no código (bg da cor do
         perfil + texto claro); a padrão usa bg_aba. -->
    <style name="OpcaoFormaPagamento">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_aba</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Linhas do bottom_sheet_origem_arquivo (câmera / galeria / PDF). -->
    <style name="LinhaOrigemArquivo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_tile_rota</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="IconeOrigemArquivo">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_circulo_branco</item>
        <item name="android:padding">11dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/rota_destaque</item>
    </style>

    <style name="TituloOrigemArquivo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ResumoOrigemArquivo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SetaOrigemArquivo">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_direita</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_tertiary</item>
    </style>

    <!-- Menu lateral (drawer_motorista / drawer_responsavel). O item ativo é
         marcado com isSelected = true pela Home (vira a "aba" clara). -->
    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:foreground">@drawable/ripple_drawer_item</item>
    </style>

    <style name="DrawerItemIcone">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="tint">@color/drawer_item_conteudo</item>
    </style>

    <style name="DrawerItemTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/drawer_item_conteudo</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Variante do menu do motorista: aba escura, conteúdo escuro no corpo claro. -->
    <style name="DrawerItem.Motorista">
        <item name="android:background">@drawable/bg_drawer_item_motorista</item>
    </style>

    <style name="DrawerItemIcone.Motorista">
        <item name="tint">@color/drawer_item_conteudo_motorista</item>
    </style>

    <style name="DrawerItemTexto.Motorista">
        <item name="android:textColor">@color/drawer_item_conteudo_motorista</item>
    </style>

</resources>
