<?xml version="1.0" encoding="utf-8"?>
<!-- Dia da semana na criação/edição da rota: escuro quando escolhido. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/rota_destaque" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/rota_tile" />
        </shape>
    </item>
</selector>
