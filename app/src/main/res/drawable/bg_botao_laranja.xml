<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de ação do cabeçalho nas telas do responsável (ex.: "Novo passageiro"). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/passageiro_destaque_forte"
                android:startColor="@color/passageiro_destaque" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
