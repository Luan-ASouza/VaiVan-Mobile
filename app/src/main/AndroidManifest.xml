<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ==================== PERMISSÕES ==================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Rastreio da viagem em segundo plano (RastreioViagemService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".core.VaiVanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_vaivan_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_vaivan_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaiVan"
        tools:targetApi="31">
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.DocumentosMotoristaActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.AnaliseDocumentosActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider> <!-- ==================== GOOGLE MAPS ==================== -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAC4LdrVL7j8NPbG1Sfyfeb0qWE9rNs9Qs" /> <!-- ==================== INICIALIZAÇÃO ==================== -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.inicio.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ==================== AUTENTICAÇÃO ==================== -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.inicio.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.inicio.EscolhaTipoPerfilActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.inicio.TermosUsoActivity"
            android:exported="false" /> <!-- ==================== CADASTRO ==================== -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.inicio.cadastro.CadastroActivity"
            android:exported="false" /> <!-- Planos e assinatura -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.assinatura.AssinaturaActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.assinatura.PagamentosMotoristaActivity"
            android:exported="false" /> <!-- ==================== MOTORISTA ==================== -->

        <activity
            android:name=".ui.motorista.precos.TabelaPrecoActivity"
            android:exported="false" />

        <!-- Entrada -->


        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.EntradaMotoristaActivity"
            android:exported="false" /> <!-- Home -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.HomeMotoristaActivity"
            android:exported="false" /> <!-- Veículos -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.veiculos.CadastroVeiculoActivity"
            android:exported="false" /> <!-- Cadastro / Documentos -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.CapturaSelfieActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.EnvioCnhActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.EnvioComprovanteResidenciaActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.entrada.documentos.StatusDocumentosVeiculoActivity"
            android:exported="false" /> <!-- Rotas -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.rotas.CriarRotaActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.rotas.RotaDetalheActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.rotas.RotaCalculadaActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.rotas.VisualizarRotaActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.motorista.rotas.navegacao.NavegacaoViagemActivity"
            android:exported="false" />
        <!-- Publica posição/rota/ETA da viagem com o app minimizado -->
        <service
            android:name=".ui.motorista.rotas.navegacao.RastreioViagemService"
            android:exported="false"
            android:foregroundServiceType="location" /> <!-- ==================== RESPONSÁVEL ==================== -->
        <!-- Home -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.HomeResponsavelActivity"
            android:exported="false" /> <!-- Passageiros -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.AdicionarPassageiroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.AdicionarLocalActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.SelecaoLocalizacaoActivity"
            android:exported="false" /> <!-- Rotas -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.rotas.PesquisarRotasActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.rotas.AcompanharViagemActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.mensalidades.MensalidadesResponsavelActivity"
            android:exported="false" />

        <!-- ==================== COMUM ==================== -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.perfil.EditarCampoPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.perfil.EditarDataNascimentoActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.perfil.EditarEnderecoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.perfil.EditarFotoPerfilActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.perfil.AlterarSenhaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.locais.LocaisSalvosActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.avatar.EscolherAvatarActivity"
            android:exported="false" />

        <!-- Perfil do passageiro (uma tela por campo) -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.perfil.PerfilPassageiroActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.perfil.EditarCampoPassageiroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.perfil.EditarNascimentoPassageiroActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.perfil.EditarNecessidadesPassageiroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.passageiros.perfil.FotoPassageiroActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.comum.recorte.RecorteImagemActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.responsavel.rotas.ResultadosRotasActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.admin.ImportarEscolasActivity"
            android:exported="true" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.escolas.SelecionarEscolaActivity"
            android:exported="false" />

        <!-- ==================== NOTIFICAÇÕES (FCM) ==================== -->
        <service
            android:name=".core.notificacao.VaiVanMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacao" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/orange" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cadastro" />
    </application>

</manifest>